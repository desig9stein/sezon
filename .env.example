# Absolute site URL used for canonical links, sitemap and Open Graph.
# Set it as a real environment variable in the deploy environment (Cloudflare Pages settings):
# astro.config.mjs reads process.env before .env files are loaded.
PUBLIC_SITE_URL=https://sezon.example
# Google AdSense publisher id (ca-pub-...). Leave empty to disable AdSense.
PUBLIC_ADSENSE_CLIENT=
# Public contact email for error reports and farm submissions. Leave empty to show only GitHub.
PUBLIC_CONTACT_EMAIL=
