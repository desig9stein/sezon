# Absolute site URL used for canonical links, sitemap and Open Graph.
# Set it as a real environment variable in the deploy environment (Cloudflare Pages settings):
# astro.config.mjs reads process.env before .env files are loaded.
PUBLIC_SITE_URL=https://sezon.example
# Google AdSense publisher id (ca-pub- and 10-20 digits). Leave empty to disable AdSense:
# then no AdSense markup, script or consent message is rendered (spec 045).
PUBLIC_ADSENSE_CLIENT=
# AdSense ad unit id (the digits of data-ad-slot in the ad code). Required when
# PUBLIC_ADSENSE_CLIENT is set; ignored otherwise.
PUBLIC_ADSENSE_SLOT=
