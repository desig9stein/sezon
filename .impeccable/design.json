      "html": "<svg class=\"ds-strip\" role=\"img\" aria-label=\"Разгар: юни – юли; В сезон: май, август; От хранилище: април, ноември – декември\" width=\"133\" height=\"16\" viewBox=\"0 0 133 16\"><title>Разгар: юни – юли; В сезон: май, август; От хранилище: април, ноември – декември</title><rect class=\"ds-strip-base\" x=\"2\" y=\"12\" width=\"8\" height=\"2\"/><rect class=\"ds-strip-cell\" data-level=\"none\" x=\"2.75\" y=\"2.75\" width=\"6.5\" height=\"10.5\" fill=\"none\" stroke-width=\"1.5\"/><rect class=\"ds-strip-base\" x=\"13\" y=\"12\" width=\"8\" height=\"2\"/><rect class=\"ds-strip-cell\" data-level=\"none\" x=\"13.75\" y=\"2.75\" width=\"6.5\" height=\"10.5\" fill=\"none\" stroke-width=\"1.5\"/><rect class=\"ds-strip-base\" x=\"24\" y=\"12\" width=\"8\" height=\"2\"/><rect class=\"ds-strip-cell\" data-level=\"none\" x=\"24.75\" y=\"2.75\" width=\"6.5\" height=\"10.5\" fill=\"none\" stroke-width=\"1.5\"/><rect class=\"ds-strip-cell\" data-level=\"storage\" x=\"35.75\" y=\"2.75\" width=\"6.5\" height=\"10.5\" fill=\"none\" stroke-width=\"1.5\"/><path class=\"ds-strip-hatch\" d=\"M35 8L41 2M35 14L43 6M37 14L43 8\" fill=\"none\" stroke-width=\"1\"/><rect class=\"ds-strip-cell\" data-level=\"available\" x=\"46.75\" y=\"2.75\" width=\"6.5\" height=\"10.5\" fill=\"none\" stroke-width=\"1.5\"/><rect class=\"ds-strip-peak\" x=\"57\" y=\"2\" width=\"8\" height=\"12\"/><rect class=\"ds-strip-peak\" x=\"68\" y=\"2\" width=\"8\" height=\"12\"/><rect class=\"ds-strip-current\" x=\"66.75\" y=\"0.75\" width=\"10.5\" height=\"14.5\" fill=\"none\" stroke-width=\"1.5\"/><rect class=\"ds-strip-cell\" data-level=\"available\" x=\"79.75\" y=\"2.75\" width=\"6.5\" height=\"10.5\" fill=\"none\" stroke-width=\"1.5\"/><rect class=\"ds-strip-base\" x=\"90\" y=\"12\" width=\"8\" height=\"2\"/><rect class=\"ds-strip-cell\" data-level=\"none\" x=\"90.75\" y=\"2.75\" width=\"6.5\" height=\"10.5\" fill=\"none\" stroke-width=\"1.5\"/><rect class=\"ds-strip-base\" x=\"101\" y=\"12\" wi