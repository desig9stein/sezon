  "components": [
    {
      "name": "Season Stamp (peak / available / storage)",
      "kind": "chip",
      "refersTo": "season-stamp-peak",
      "description": "Level as a stamp: solid „Разгар“, outlined „В сезон“, hatched „От хранилище“ with the word on a surface pad; condensed capitals, word always shown.",
      "html": "<span class=\"ds-stamp\" data-level=\"peak\"><span class=\"ds-stamp-word\">Разгар</span></span> <span class=\"ds-stamp\" data-level=\"available\"><span class=\"ds-stamp-word\">В сезон</span></span> <span class=\"ds-stamp\" data-level=\"storage\"><span class=\"ds-stamp-word\">От хранилище</span></span>",
      "css": ".ds-stamp{display:inline-flex;align-items:center;padding:.2em .5em;border:2px solid var(--color-accent);color:var(--color-accent);background:var(--color-surface);font-family:var(--font-family-display);font-size:var(--font-size-sm);font-weight:800;line-height:1.1;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap}.ds-stamp[data-level=peak]{border-color:var(--color-peak);color:var(--color-on-peak);background:var(--color-peak)}.ds-stamp[data-level=storage]{padding:.2em;color:var(--color-text);background:repeating-linear-gradient(135deg,var(--color-accent) 0 1px,var(--color-surface) 1px 5px)}.ds-stamp[data-level=storage] .ds-stamp-word{padding-inline:.3em;background:var(--color-surface)}"
