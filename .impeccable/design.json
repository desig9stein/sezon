      "css": ".ds-badge{display:inline-flex;align-items:center;gap:var(--space-1);padding:var(--space-1) var(--space-2);border-radius:var(--radius-sm);color:var(--color-on-badge);font-family:var(--font-family-base);font-size:var(--font-size-sm);font-weight:600;line-height:1.2}.ds-badge[data-level=peak]{color:var(--color-on-peak);background:var(--color-peak)}.ds-badge[data-level=available]{background:var(--color-available)}.ds-badge[data-level=storage]{background:var(--color-storage)}.ds-mark{width:1em;height:1em;flex:none}.ds-plate{display:grid;gap:var(--space-2);min-height:13rem;align-content:start;padding:var(--space-6) var(--space-4) var(--space-4);background:var(--color-surface);color:var(--color-text);border-radius:var(--radius-sm);font-family:var(--font-family-base)}.ds-plate-name{margin:0;font-family:var(--font-family-display);font-weight:800;font-size:var(--font-size-xl);line-height:1.15;letter-spacing:.02em;text-transform:uppercase}.ds-plate-name a{display:inline-flex;align-items:center;min-height:var(--target-min);color:var(--color-text);text-underline-offset:.2em}.ds-plate-name a:hover{text-decoration-thickness:2px}.ds-plate-name a:focus-visible{outline:var(--focus-width) solid var(--color-focus);outline-offset:2px}.ds-plate-meta{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-1) var(--space-3);margin:0;color:var(--color-text-muted);font-size:var(--font-size-sm)}.ds-plate-meta [lang=la]{font-style:italic;font-weight:400}.ds-plate-summary{margin:0;max-width:42ch;color:var(--color-text-muted)}"
