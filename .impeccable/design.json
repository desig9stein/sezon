      "css": ".ds-ribbon{display:grid;grid-template-columns:repeat(12,1fr);margin:0;padding:0;list-style:none;border-block:1px solid var(--color-rule);font-family:var(--font-family-base)}.ds-ribbon li+li{border-inline-start:1px solid var(--color-rule)}.ds-ribbon a{display:flex;align-items:center;justify-content:center;min-height:2.75rem;color:var(--color-text-muted);text-decoration:none}.ds-ribbon a:hover{color:var(--color-text);text-decoration:underline}.ds-ribbon a:focus-visible{outline:var(--focus-width) solid var(--color-focus);outline-offset:2px}.ds-ribbon a[aria-current=date]{color:var(--color-accent-text);background:var(--color-accent);font-weight:700}"
