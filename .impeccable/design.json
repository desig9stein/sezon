      "html": "<article class=\"ds-farm\"><h3 class=\"ds-farm-name\">Ферма</h3><p class=\"ds-farm-meta\"><span class=\"ds-farm-tag\">Пловдив</span><span class=\"ds-farm-tag\">Био</span></p><ul class=\"ds-farm-contacts\"><li><a href=\"#\">Уебсайт</a></li></ul></article>",
      "css": ".ds-farm{display:grid;gap:var(--space-2);padding:var(--space-4);border-radius:var(--radius-sm);background:var(--color-surface);color:var(--color-text);font-family:var(--font-family-base)}.ds-farm-name{margin:0;font-family:var(--font-family-display);font-weight:800;font-size:var(--font-size-lg);letter-spacing:.02em;text-transform:uppercase;line-height:1.15}.ds-farm-meta{display:flex;flex-wrap:wrap;gap:var(--space-2);margin:0;color:var(--color-text-muted);font-size:var(--font-size-sm)}.ds-farm-tag{padding:0 var(--space-2);border:1px solid var(--color-border);border-radius:var(--radius-sm)}.ds-farm-contacts{margin:0;padding:0;list-style:none}.ds-farm-contacts a{display:inline-flex;align-items:center;min-height:var(--target-min);color:var(--color-accent);text-underline-offset:.2em}.ds-farm-contacts a:hover{text-decoration-thickness:2px}.ds-farm-contacts a:focus-visible{outline:var(--focus-width) solid var(--color-focus);outline-offset:2px}"
