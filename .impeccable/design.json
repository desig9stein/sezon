      "html": "<span class=\"ds-badge\" data-level=\"peak\"><svg class=\"ds-mark\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><polygon fill=\"currentColor\" points=\"8,0.8 10.2,5.7 15.5,6.2 11.5,9.7 12.7,14.9 8,12.2 3.3,14.9 4.5,9.7 0.5,6.2 5.8,5.7\"/></svg>Разгар</span> <span class=\"ds-badge\" data-level=\"available\"><svg class=\"ds-mark\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"6.5\" fill=\"currentColor\"/></svg>В сезон</span> <span class=\"ds-badge\" data-level=\"storage\"><svg class=\"ds-mark\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M8 2a6 6 0 0 0 0 12z\" fill=\"currentColor\"/></svg>От хранилище</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:var(--space-1);padding:var(--space-1) var(--space-2);border-radius:var(--radius-sm);color:var(--color-on-badge);font-family:var(--font-family-base);font-size:var(--font-size-sm);font-weight:600;line-height:1.2}.ds-badge[data-level=peak]{color:var(--color-on-peak);background:var(--color-peak)}.ds-badge[data-level=available]{background:var(--color-available)}.ds-badge[data-level=storage]{background:var(--color-storage)}.ds-mark{width:1em;height:1em;flex:none}"
