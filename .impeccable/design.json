      "css": ".ds-stamp{display:inline-flex;align-items:center;padding:.2em .5em;border:2px solid var(--color-accent);color:var(--color-accent);background:var(--color-surface);font-family:var(--font-family-display);font-size:var(--font-size-sm);font-weight:800;line-height:1.1;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap}.ds-stamp[data-level=peak]{border-color:var(--color-peak);color:var(--color-on-peak);background:var(--color-peak)}.ds-stamp[data-level=storage]{padding:.2em;color:var(--color-text);background:repeating-linear-gradient(135deg,var(--color-accent) 0 1px,var(--color-surface) 1px 5px)}.ds-stamp[data-level=storage] .ds-stamp-word{padding-inline:.3em;background:var(--color-surface)}.ds-plate{display:grid;gap:var(--space-2);min-height:13rem;align-content:start;padding:var(--space-6) var(--space-4) var(--space-4);background:var(--color-surface);color:var(--color-text);border-radius:var(--radius-sm);font-family:var(--font-family-base)}.ds-plate-name{margin:0;font-family:var(--font-family-display);font-weight:800;font-size:var(--font-size-xl);line-height:1.15;letter-spacing:.02em;text-transform:uppercase}.ds-plate-name a{display:inline-flex;align-items:center;min-height:var(--target-min);color:var(--color-text);text-underline-offset:.2em}.ds-plate-name a:hover{text-decoration-thickness:2px}.ds-plate-name a:focus-visible{outline:var(--focus-width) solid var(--color-focus);outline-offset:2px}.ds-plate-meta{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-1) var(--space-3);margin:0;color:var(--color-text-muted);font-size:var(--font-size-sm)}.ds-plate-meta [lang=la]{font-style:italic;font-weight:400}.ds-plate-summary{margin:0;max-width:42ch;color:var(--color-text-muted)}"
