---
import type { GetStaticPaths } from 'astro';
import AdSlot from '@components/ads/AdSlot.astro';
import { ADSENSE } from '@composition/adsense';
import { routes } from '@components/layout/routes';
import MonthChanges from '@components/season/MonthChanges.astro';
import MonthPager from '@components/season/MonthPager.astro';
import SeasonLegend from '@components/season/SeasonLegend.astro';
import SeasonList from '@components/season/SeasonList.astro';
import SeasonOverview from '@components/season/SeasonOverview.astro';
import { freshProduceItemList } from '@components/season/seasonJsonLd';
import { BUILD_DATE } from '@composition/clock';
import {
  monthChangesService,
  seasonOverviewService,
  sponsorSelectionService,
} from '@composition/index';
import { requireSiteUrl } from '@composition/site';
import { Month } from '@contexts/seasonality';
import { monthName, ui } from '@i18n/bg';
import BaseLayout from '@layouts/BaseLayout.astro';

export const getStaticPaths = (() =>
  Month.all().map((month) => ({ params: { month: month.slug } }))) satisfies GetStaticPaths;

const month = Month.fromSlug(Astro.params.month);
const siteUrl = requireSiteUrl(Astro.site);
const overview = await seasonOverviewService.overviewFor(month);
const changes = await monthChangesService.changesFor(month);
const freshNames = [...overview.peak, ...overview.available].map((produce) => produce.name);
const path = routes.month(month);
const itemList = freshProduceItemList(overview, siteUrl);
const sponsor = await sponsorSelectionService.forPlacement('month', BUILD_DATE);
---

<BaseLayout
  title={ui.monthPage.title(month)}
  description={ui.monthPage.description(month, freshNames)}
  path={path}
  breadcrumbs={[
    { name: ui.breadcrumbs.home, path: routes.home },
    { name: monthName(month), path },
  ]}
  jsonLd={itemList === undefined ? [] : [itemList]}
>
  <h1>{ui.monthPage.heading(month)}</h1>
  <SeasonList overview={overview} />
  <SeasonLegend />
  <MonthChanges changes={changes} />
  <SeasonOverview overview={overview} groups={['comingSoon']} stripMonth={month} />
  <AdSlot sponsor={sponsor} placement="month" adsense={ADSENSE} />
  <MonthPager month={month} />
</BaseLayout>

<style>
  h1 {
    margin-block: var(--space-6) var(--space-3);
  }
</style>
