---
import { routes } from '@components/layout/routes';
import FarmCard from '@components/produce/FarmCard.astro';
import {
  searchBodyAttributes,
  searchHubHeadingAttributes,
} from '@components/search/searchAttributes';
import { BUILD_DATE } from '@composition/clock';
import { farmPagesQuery } from '@composition/index';
import { requireSiteUrl } from '@composition/site';
import { ui } from '@i18n/bg';
import BaseLayout from '@layouts/BaseLayout.astro';
import { collectionPageJsonLd } from '@shared/seo';

const labels = ui.farms;
const path = routes.farms;
const groups = await farmPagesQuery.byRegion(BUILD_DATE);
const farms = groups.flatMap((group) => group.farms);
const sectionId = (slug: string) => `oblast-${slug}`;
const organicFarms = farms.filter((entry) => entry.certifiedOrganic);
const jsonLd = [
  collectionPageJsonLd({
    siteUrl: requireSiteUrl(Astro.site),
    path,
    name: labels.heading,
    description: labels.description,
    items: farms.map(({ farm }) => ({ name: farm.name, path: routes.farm(farm.slug) })),
  }),
];
---

<BaseLayout
  title={labels.title}
  description={labels.description}
  path={path}
  breadcrumbs={[
    { name: ui.breadcrumbs.home, path: routes.home },
    { name: labels.heading, path },
  ]}
  jsonLd={jsonLd}
>
  <div {...searchBodyAttributes(ui.search.types.section)}>
    <h1 {...searchHubHeadingAttributes(labels.heading)}>{labels.heading}</h1>
    <p class="farms__intro">{labels.intro}</p>
  </div>
  <nav class="farms__regions" aria-label={labels.byRegionLabel}>
    <ul role="list">
      {groups.map(({ region, farms: regionFarms }) => (
        <li>
          <a href={`#${sectionId(region.slug)}`}>
            {labels.regionCount(ui.regions.placeName(region.name), regionFarms.length)}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  {organicFarms.length > 0 && (
    <p class="farms__organic">
      {labels.organicLabel}{' '}
      {organicFarms.map(({ farm }, index) => (
        <>
          {index > 0 && ', '}
          <a href={routes.farm(farm.slug)}>{farm.name}</a>
        </>
      ))}
    </p>
  )}
  <p class="farms__regions-link">
    <a href={routes.regions}>{labels.regionsLink}</a>
  </p>
  {groups.map(({ region, farms: regionFarms, surrounding }) => (
    <section class="farms__region" aria-labelledby={sectionId(region.slug)}>
      <h2 class="section-heading" id={sectionId(region.slug)} tabindex="-1">
        {ui.regions.placeName(region.name)}
      </h2>
      <p>
        <a href={routes.region(region.slug)}>{labels.regionPageLink(region.name)}</a>
      </p>
      {surrounding !== undefined && (
        <p>
          <a href={`#${sectionId(surrounding.region.slug)}`}>
            {labels.nearbyFarms(
              ui.regions.placeName(surrounding.region.name),
              surrounding.farmCount,
            )}
          </a>
        </p>
      )}
      <ul class="farms" role="list">
        {regionFarms.map((entry) => (
          <FarmCard {...entry} headingLevel={3} currentRegionSlug={region.slug} />
        ))}
      </ul>
    </section>
  ))}
  <p class="farms__add">
    <a href={routes.addFarm}>{ui.produce.farms.addFarmLink}</a>
  </p>
</BaseLayout>

<style>
  h1 {
    margin-block: var(--space-6) var(--space-3);
  }

  .farms__intro {
    max-width: var(--reading-width);
    margin-bottom: var(--space-4);
  }

  .farms__regions ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .farms__regions a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-weight: 600;
  }

  .farms__region {
    display: grid;
    gap: var(--space-3);
  }

  .farms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .farms__add {
    margin-top: var(--space-8);
  }
</style>
