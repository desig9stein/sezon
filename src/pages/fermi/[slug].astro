---
import type { GetStaticPaths } from 'astro';
import { routes } from '@components/layout/routes';
import FarmContacts from '@components/farms/FarmContacts.astro';
import FarmLabels from '@components/farms/FarmLabels.astro';
import { sourceLabel } from '@components/farms/sourceLabel';
import SeasonBadge from '@components/season/SeasonBadge.astro';
import { BUILD_DATE, buildMonth } from '@composition/clock';
import { farmPagesQuery, farmRepository } from '@composition/index';
import { requireSiteUrl } from '@composition/site';
import { ui } from '@i18n/bg';
import BaseLayout from '@layouts/BaseLayout.astro';
import { localBusinessJsonLd } from '@shared/seo';

export const getStaticPaths = (async () =>
  (await farmRepository.all()).map((farm) => ({
    params: { slug: farm.slug },
  }))) satisfies GetStaticPaths;

const page = await farmPagesQuery.forSlug(Astro.params.slug, BUILD_DATE);
const { farm, region, certifiedOrganic } = page;
const labels = ui.farms;
const path = routes.farm(farm.slug);
const description = labels.pageDescription(
  farm.name,
  region.name,
  page.produce.map((item) => item.name),
);
const jsonLd = [
  localBusinessJsonLd({
    siteUrl: requireSiteUrl(Astro.site),
    path,
    name: farm.name,
    description: farm.description,
    telephone: farm.contact.phone,
    email: farm.contact.email,
    address: farm.address,
    website: farm.contact.website,
  }),
];
---

<BaseLayout
  title={labels.pageTitle(farm.name)}
  description={description}
  path={path}
  breadcrumbs={[
    { name: ui.breadcrumbs.home, path: routes.home },
    { name: labels.heading, path: routes.farms },
    { name: farm.name, path },
  ]}
  jsonLd={jsonLd}
>
  <article class="farm-page">
    <h1>{farm.name}</h1>
    <p class="farm-page__meta">
      <a href={routes.region(region.slug)}>{ui.regions.placeName(region.name)}</a>
      <FarmLabels farm={farm} certifiedOrganic={certifiedOrganic} />
    </p>
    <p class="farm-page__description">{farm.description}</p>

    <section aria-labelledby="farm-produce">
      <h2 class="section-heading" id="farm-produce">
        {labels.produceHeading}
      </h2>
      <ul class="farm-produce" role="list">
        {page.produce.map((produce) => {
          const level = produce.levelIn(buildMonth);
          return (
            <li>
              <span>
                <a href={routes.produce(produce)}>{produce.name}</a>
                <span class="farm-produce__separator">{labels.produceSeparator}</span>
              </span>
              {level === undefined ? (
                <span class="farm-produce__out">{ui.produce.outOfSeason}</span>
              ) : (
                <SeasonBadge level={level} />
              )}
            </li>
          );
        })}
      </ul>
    </section>

    <section aria-labelledby="farm-contacts">
      <h2 class="section-heading" id="farm-contacts">
        {labels.contactsHeading}
      </h2>
      <FarmContacts farm={farm} />
      {farm.address !== undefined && (
        <p>
          <strong>{labels.addressLabel}</strong> {farm.address}
        </p>
      )}
    </section>

    <section aria-labelledby="farm-sources">
      <h2 class="section-heading" id="farm-sources">
        {labels.sourcesHeading}
      </h2>
      <p class="farm-page__muted">{labels.sourcesNote}</p>
      <ul class="farm-page__sources">
        {farm.sources.map((url) => (
          <li>
            <a href={url} rel="noopener">
              {sourceLabel(url)}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .farm-page {
    display: grid;
    gap: var(--space-4);
    max-width: var(--reading-width);
    margin-top: var(--space-6);
  }

  .farm-page__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: var(--color-text-muted);
  }

  .farm-produce__separator {
    color: var(--color-text-muted);
  }

  .farm-page__description {
    font-size: var(--font-size-lg);
  }

  .farm-produce {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .farm-produce li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
  }

  .farm-produce a {
    color: var(--color-text);
    font-weight: 700;
  }

  .farm-produce__out,
  .farm-page__muted {
    color: var(--color-text-muted);
  }

  .farm-page__sources {
    display: grid;
    gap: var(--space-1);
    overflow-wrap: anywhere;
  }
</style>
