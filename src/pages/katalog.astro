---
import { routes } from '@components/layout/routes';
import { catalogIndexService } from '@composition/index';
import { requireSiteUrl } from '@composition/site';
import { ui } from '@i18n/bg';
import BaseLayout from '@layouts/BaseLayout.astro';
import { collectionPageJsonLd } from '@shared/seo';

const catalog = await catalogIndexService.index();
const labels = ui.catalog;
const path = routes.catalog;
const jsonLd = [
  collectionPageJsonLd({
    siteUrl: requireSiteUrl(Astro.site),
    path,
    name: labels.heading,
    description: labels.description,
    items: [
      ...catalog.sections.map(({ kind }) => ({
        name: ui.sections.names[kind],
        path: routes.section(kind),
      })),
      ...catalog.groups.map(({ group }) => ({ name: group.name, path: routes.group(group.slug) })),
    ],
  }),
];
---

<BaseLayout
  title={labels.title}
  description={labels.description}
  path={path}
  breadcrumbs={[
    { name: ui.breadcrumbs.home, path: routes.home },
    { name: labels.heading, path },
  ]}
  jsonLd={jsonLd}
>
  <h1>{labels.heading}</h1>
  <p class="catalog__intro">{labels.intro}</p>

  <section aria-labelledby="catalog-sections">
    <h2 class="section-heading" id="catalog-sections">
      {labels.sectionsHeading}
    </h2>
    <ul class="catalog__sections" role="list">
      {catalog.sections.map(({ kind, count }) => (
        <li>
          <a href={routes.section(kind)}>
            <span class="catalog__section-name">{ui.sections.names[kind]}</span>
            <span class="catalog__count">({labels.count(count)})</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="catalog-groups">
    <h2 class="section-heading" id="catalog-groups">
      {labels.groupsHeading}
    </h2>
    <ul class="catalog__chips" role="list">
      {catalog.groups.map(({ group, count }) => (
        <li>
          <a href={routes.group(group.slug)}>
            {group.name} <span class="catalog__count">({labels.count(count)})</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="catalog-regions">
    <h2 class="section-heading" id="catalog-regions">
      {ui.regions.heading}
    </h2>
    <p>
      <a href={routes.regions}>{labels.regionsLink}</a>
    </p>
  </section>

  <section aria-labelledby="catalog-farms">
    <h2 class="section-heading" id="catalog-farms">
      {ui.farms.heading}
    </h2>
    <p>
      <a href={routes.farms}>{labels.farmsLink}</a>
    </p>
  </section>

  <section aria-labelledby="catalog-nutrients">
    <h2 class="section-heading" id="catalog-nutrients">
      {labels.nutrientsHeading}
    </h2>
    <ul class="catalog__chips" role="list">
      {catalog.nutrients.map((nutrient) => (
        <li>
          <a href={routes.nutrient(nutrient.slug)}>{nutrient.name}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  h1 {
    margin-top: var(--space-6);
  }

  .catalog__intro {
    max-width: var(--reading-width);
    font-size: var(--font-size-lg);
  }

  .catalog__sections {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .catalog__sections a {
    display: grid;
    gap: var(--space-1);
    min-height: 5rem;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    color: var(--color-on-shell);
    background: var(--color-shell);
    text-decoration: none;
  }

  .catalog__sections a:hover .catalog__section-name {
    text-decoration: underline;
  }

  .catalog__sections a:focus-visible {
    outline-color: var(--color-focus);
  }

  .catalog__section-name {
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .catalog__sections .catalog__count {
    font-size: var(--font-size-sm);
  }

  .catalog__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .catalog__chips a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    background: var(--color-surface);
    font-weight: 600;
    text-decoration: none;
  }

  .catalog__chips a:hover {
    text-decoration: underline;
  }

  .catalog__chips .catalog__count {
    color: var(--color-text-muted);
    font-weight: 400;
  }
</style>
