---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import AdSlot from '@components/ads/AdSlot.astro';
import { ADSENSE } from '@composition/adsense';
import FarmList from '@components/produce/FarmList.astro';
import GrowingGuide from '@components/produce/GrowingGuide.astro';
import GrowingRegions from '@components/produce/GrowingRegions.astro';
import ProducePhoto from '@components/produce/ProducePhoto.astro';
import NutritionTable from '@components/produce/NutritionTable.astro';
import SeasonCalendarList from '@components/produce/SeasonCalendarList.astro';
import ProduceNow from '@components/produce/ProduceNow.astro';
import { hasEatContent, produceToc } from '@components/produce/produceToc';
import SourceList from '@components/produce/SourceList.astro';
import TraditionalUses from '@components/produce/TraditionalUses.astro';
import ProduceRecipes from '@components/recipes/ProduceRecipes.astro';
import { routes } from '@components/layout/routes';
import { produceOgCard } from '@components/seo/ogImage';
import { BUILD_DATE, buildMonth } from '@composition/clock';
import {
  produceDetailsQuery,
  produceRepository,
  recipeIndexService,
  sponsorSelectionService,
} from '@composition/index';
import { requireSiteUrl } from '@composition/site';
import { produceTitle, ui } from '@i18n/bg';
import BaseLayout from '@layouts/BaseLayout.astro';
import { articleJsonLd, faqPageJsonLd } from '@shared/seo';
import { searchHeadingAttributes } from '@components/search/searchAttributes';

export const getStaticPaths = (async () =>
  (await produceRepository.all()).map((produce) => ({
    params: { section: routes.produceSection(produce.kind), slug: produce.slug },
  }))) satisfies GetStaticPaths;

const details = await produceDetailsQuery.forSlug(Astro.params.slug, BUILD_DATE);
const { produce, group } = details;
const path = routes.produce(produce);
const siteUrl = requireSiteUrl(Astro.site);
const labels = ui.produce;
const sponsor = await sponsorSelectionService.forPlacement('produce', BUILD_DATE);
const recipes = await recipeIndexService.forProduce(produce.slug);
const toc = produceToc(produce, recipes.length);
const SHARE_IMAGE_WIDTH = 1200;
const shareImage =
  produce.photo === undefined
    ? undefined
    : await getImage({ src: produce.photo.image, width: SHARE_IMAGE_WIDTH, format: 'jpg' });
const jsonLd = [
  articleJsonLd({
    siteUrl,
    path,
    headline: produce.name,
    description: produce.summary,
    dateModified: produce.updatedAt,
    about: { name: produce.name, alternateName: produce.latinName },
    citations: details.sources,
    imagePath: shareImage?.src,
  }),
  ...(produce.faq.length > 0 ? [faqPageJsonLd(produce.faq)] : []),
];
---

<BaseLayout
  title={produceTitle(produce.name)}
  description={produce.summary}
  path={path}
  type="article"
  ogImage={produceOgCard(produce, buildMonth)}
  breadcrumbs={[
    { name: ui.breadcrumbs.home, path: routes.home },
    { name: ui.sections.names[produce.kind], path: routes.section(produce.kind) },
    { name: produce.name, path },
  ]}
  jsonLd={jsonLd}
>
  <article class="produce" data-pagefind-body>
    <header class="produce__header">
      <h1 {...searchHeadingAttributes(produce.name)}>{produce.name}</h1>
      <ul class="produce__meta" role="list">
        {produce.latinName !== undefined && (
          <li>
            <i lang="la">{produce.latinName}</i>
          </li>
        )}
        <li>{ui.produceKinds[produce.kind]}</li>
        <li>
          {labels.familyLabel}{' '}
          <a href={routes.group(group.slug)}>
            {group.name} (<i lang="la">{group.latinName}</i>)
          </a>
        </li>
      </ul>
      <p class="produce__summary">{produce.summary}</p>
      {produce.photo !== undefined && (
        <ProducePhoto photo={produce.photo} latinName={produce.latinName} />
      )}
    </header>

    <nav class="produce__toc" aria-label={labels.toc}>
      <ul role="list">
        {toc.map((entry) => (
          <li>
            <a href={`#${entry.id}`}>{entry.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <section id="stall" class="produce__group produce__wide" aria-labelledby="stall-heading">
      <h2 id="stall-heading">{labels.headings.stall}</h2>
      <ProduceNow produce={produce} month={buildMonth} />
      <section class="produce__wide" aria-labelledby="season">
        <h3 id="season">{labels.headings.season}</h3>
        <SeasonCalendarList produce={produce} currentMonth={buildMonth} />
      </section>
      {produce.howToChoose !== undefined && (
        <section aria-labelledby="choose">
          <h3 id="choose">{labels.headings.choose}</h3>
          <p>{produce.howToChoose}</p>
        </section>
      )}
      {produce.storage !== undefined && (
        <section aria-labelledby="storage">
          <h3 id="storage">{labels.headings.storage}</h3>
          <p>{produce.storage}</p>
        </section>
      )}
      {produce.varieties.length > 0 && (
        <section aria-labelledby="varieties">
          <h3 id="varieties">{labels.headings.varieties}</h3>
          <ul>
            {produce.varieties.map((variety) => (
              <li>
                {variety.name}
                {variety.note !== undefined && ` – ${variety.note}`}
              </li>
            ))}
          </ul>
        </section>
      )}
      <section aria-labelledby="regions">
        <h3 id="regions">{labels.headings.regions}</h3>
        <GrowingRegions regions={details.growingRegions} />
        <p>
          <a href="#farms">{labels.farmsLink}</a>
        </p>
      </section>
    </section>

    {hasEatContent(produce, recipes.length) && (
      <section id="eat" class="produce__group produce__wide" aria-labelledby="eat-heading">
        <h2 id="eat-heading">{labels.headings.eat}</h2>
        {produce.nutrition !== undefined && (
          <section aria-labelledby="nutrition">
            <h3 id="nutrition">{labels.headings.nutrition}</h3>
            <NutritionTable nutrition={produce.nutrition} micronutrients={details.micronutrients} />
          </section>
        )}
        {produce.preparation.length > 0 && (
          <section aria-labelledby="preparation">
            <h3 id="preparation">{labels.headings.preparation}</h3>
            <dl class="preparation">
              {produce.preparation.map((tip) => (
                <>
                  <dt>{tip.method}</dt>
                  <dd>{tip.tip}</dd>
                </>
              ))}
            </dl>
          </section>
        )}
        {produce.traditionalUses.length > 0 && (
          <section aria-labelledby="traditional">
            <h3 id="traditional">{labels.headings.traditional}</h3>
            <TraditionalUses uses={produce.traditionalUses} />
          </section>
        )}
        <ProduceRecipes recipes={recipes} />
      </section>
    )}

    <AdSlot sponsor={sponsor} placement="produce" adsense={ADSENSE} />

    {produce.growing !== undefined && (
      <section id="grow" class="produce__group produce__wide" aria-labelledby="grow-heading">
        <h2 id="grow-heading">{labels.headings.grow}</h2>
        <GrowingGuide growing={produce.growing} headingLevel={3} />
      </section>
    )}

    <section class="produce__wide" aria-labelledby="farms">
      <h2 id="farms">{labels.headings.farms}</h2>
      <FarmList farms={details.farms} organic={produce.organic} />
    </section>

    {produce.faq.length > 0 && (
      <section aria-labelledby="faq">
        <h2 id="faq">{labels.headings.faq}</h2>
        {produce.faq.map((item) => (
          <>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </>
        ))}
      </section>
    )}

    <section aria-labelledby="sources">
      <h2 id="sources">{labels.headings.sources}</h2>
      <SourceList sources={details.sources} updatedAt={produce.updatedAt} />
    </section>
  </article>
</BaseLayout>

<style>
  .produce {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-6);
  }

  .produce section {
    display: grid;
    gap: var(--space-3);
    max-width: var(--reading-width);
  }

  .produce .produce__wide {
    max-width: none;
  }

  @media print {
    .produce__toc {
      display: none;
    }
  }

  .produce__toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .produce__toc a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-text);
    color: var(--color-text);
    background: var(--color-surface);
    font-weight: 600;
    text-decoration: none;
  }

  .produce__toc a:hover {
    text-decoration: underline;
  }

  .produce .produce__group {
    gap: var(--space-6);
    padding-top: var(--space-2);
    border-top: 2px solid var(--color-text);
  }

  .produce__header {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    .produce__header:has(> :global(.produce-photo)) {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      grid-template-rows: auto auto auto 1fr;
      column-gap: var(--space-8);
      align-items: start;
    }

    .produce__header > h1,
    .produce__header > .produce__meta {
      grid-column: 1 / -1;
    }

    .produce__header > :global(.produce-photo) {
      grid-column: 2;
      grid-row: 3 / -1;
    }
  }

  .produce__header h1 {
    font-size: var(--font-size-3xl);
    line-height: 0.95;
  }

  .produce__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-text-muted);
  }

  .produce__meta > li > [lang='la'] {
    font-size: var(--font-size-lg);
  }

  .produce__summary {
    max-width: var(--reading-width);
    font-size: var(--font-size-lg);
  }

  .produce section ul {
    display: grid;
    gap: var(--space-1);
    padding-inline-start: var(--space-6);
  }

  .preparation dt {
    font-weight: 700;
  }

  .preparation dd {
    margin: 0 0 var(--space-3);
  }
</style>
