---
import { routes } from '@components/layout/routes';
import { buildMonth } from '@composition/clock';
import { ui } from '@i18n/bg';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title={ui.notFound.title} description={ui.notFound.description} path="/404" noindex>
  <h1>{ui.notFound.heading}</h1>
  <p class="lead">{ui.notFound.intro}</p>
  <ul class="links" role="list">
    <li>
      <a href={routes.home}>{ui.notFound.homeLink}</a>
    </li>
    <li>
      <a href={routes.month(buildMonth)}>{ui.notFound.monthLink(buildMonth)}</a>
    </li>
  </ul>
</BaseLayout>

<style>
  h1 {
    margin-top: var(--space-8);
  }

  .lead {
    max-width: var(--reading-width);
    margin-top: var(--space-3);
  }

  .links {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-weight: 600;
  }
</style>
