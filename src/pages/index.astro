---
import { routes } from '@components/layout/routes';
import SeasonOverview from '@components/season/SeasonOverview.astro';
import YearRibbon from '@components/season/YearRibbon.astro';
import { freshProduceItemList } from '@components/season/seasonJsonLd';
import { buildMonth } from '@composition/clock';
import { seasonOverviewService } from '@composition/index';
import { requireSiteUrl } from '@composition/site';
import { monthNameLower, ui } from '@i18n/bg';
import BaseLayout from '@layouts/BaseLayout.astro';
import { websiteJsonLd } from '@shared/seo';

const siteUrl = requireSiteUrl(Astro.site);
const overview = await seasonOverviewService.overviewFor(buildMonth);
const nextMonth = buildMonth.next();
const itemList = freshProduceItemList(overview, siteUrl);
---

<BaseLayout
  title={ui.home.title}
  description={ui.home.description(buildMonth)}
  path={routes.home}
  jsonLd={[
    websiteJsonLd({ siteUrl, name: ui.siteName, description: ui.siteDescription }),
    ...(itemList === undefined ? [] : [itemList]),
  ]}
>
  <section class="hero" aria-labelledby="home-heading">
    <p class="hero__plate">{ui.home.plate(buildMonth)}</p>
    <h1 id="home-heading">
      <span class="hero__lead">{ui.home.headingLead}</span>
      <span class="hero__month">{monthNameLower(buildMonth)}</span>
    </h1>
    <p class="hero__intro">{ui.home.intro}</p>
    <YearRibbon current={buildMonth} />
  </section>
  <SeasonOverview overview={overview} groups={['peak', 'comingSoon']} />
  <ul class="more-links" role="list">
    <li>
      <a href={routes.month(buildMonth)}>{ui.home.fullMonthLink(buildMonth)}</a>
    </li>
    <li>
      <a href={routes.month(nextMonth)}>{ui.home.nextMonthLink(nextMonth)}</a>
    </li>
  </ul>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-12) var(--space-4);
  }

  .hero__plate {
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .hero h1 {
    display: grid;
    gap: var(--space-2);
  }

  .hero__lead {
    font-family: var(--font-family-base);
    font-size: var(--font-size-lg);
    font-weight: 500;
  }

  .hero__month {
    margin-inline-start: -0.04em;
    font-size: var(--font-size-display);
    line-height: 0.85;
    letter-spacing: -0.035em;
    text-transform: capitalize;
    overflow-wrap: anywhere;
  }

  .hero__intro {
    max-width: 34ch;
    margin-top: var(--space-2);
    font-size: var(--font-size-lg);
  }

  .more-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-12);
    padding: 0;
    list-style: none;
  }

  .more-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-weight: 600;
  }
</style>
