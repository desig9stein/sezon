---
import { routes } from '@components/layout/routes';
import SeasonLegend from '@components/season/SeasonLegend.astro';
import SeasonList from '@components/season/SeasonList.astro';
import SeasonOverview from '@components/season/SeasonOverview.astro';
import { freshProduceItemList } from '@components/season/seasonJsonLd';
import { buildMonth } from '@composition/clock';
import { seasonOverviewService } from '@composition/index';
import { requireSiteUrl } from '@composition/site';
import { monthNameLower, ui } from '@i18n/bg';
import BaseLayout from '@layouts/BaseLayout.astro';
import { websiteJsonLd } from '@shared/seo';

const siteUrl = requireSiteUrl(Astro.site);
const overview = await seasonOverviewService.overviewFor(buildMonth);
const nextMonth = buildMonth.next();
const itemList = freshProduceItemList(overview, siteUrl);
---

<BaseLayout
  title={ui.home.title}
  description={ui.home.description(buildMonth)}
  path={routes.home}
  jsonLd={[
    websiteJsonLd({
      siteUrl,
      name: ui.siteName,
      description: ui.siteDescription,
      searchPath: routes.search,
    }),
    ...(itemList === undefined ? [] : [itemList]),
  ]}
>
  <h1 class="home-heading">
    <span class="home-heading__lead">{ui.home.headingLead}</span>
    <span class="home-heading__month">{monthNameLower(buildMonth)}</span>
  </h1>
  <SeasonList
    overview={overview}
    heading={ui.seasonList.countHeading(
      overview.peak.length + overview.available.length + overview.storage.length,
    )}
  />
  <SeasonLegend />
  <p class="home-intro">{ui.home.intro}</p>
  <SeasonOverview overview={overview} groups={['comingSoon']} stripMonth={buildMonth} />
  <ul class="more-links" role="list">
    <li>
      <a href={routes.month(buildMonth)}>{ui.home.fullMonthLink(buildMonth)}</a>
    </li>
    <li>
      <a href={routes.month(nextMonth)}>{ui.home.nextMonthLink(nextMonth)}</a>
    </li>
    <li>
      <a href={routes.calendar}>{ui.calendar.homeLink}</a>
    </li>
  </ul>
</BaseLayout>

<style>
  .home-heading {
    display: grid;
    margin-block: var(--space-3) var(--space-2);
  }

  .home-heading__lead {
    font-family: var(--font-family-base);
    font-size: var(--font-size-base);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }

  .home-heading__month {
    font-size: var(--font-size-3xl);
    line-height: 0.9;
    overflow-wrap: anywhere;
  }

  .home-intro {
    max-width: var(--reading-width);
    margin-top: var(--space-6);
    color: var(--color-text-muted);
  }

  .more-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-12);
    padding: 0;
    list-style: none;
  }

  .more-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-weight: 600;
  }
</style>
