---
import type { GetStaticPaths } from 'astro';
import { routes } from '@components/layout/routes';
import FarmList from '@components/produce/FarmList.astro';
import ProvinceMap from '@components/produce/ProvinceMap.astro';
import { BUILD_DATE } from '@composition/clock';
import { regionPagesQuery } from '@composition/index';
import { requireSiteUrl } from '@composition/site';
import { ui } from '@i18n/bg';
import BaseLayout from '@layouts/BaseLayout.astro';
import { administrativeAreaJsonLd } from '@shared/seo';

export const getStaticPaths = (async () =>
  (await regionPagesQuery.pageSlugs()).map((slug) => ({
    params: { slug },
  }))) satisfies GetStaticPaths;

const page = await regionPagesQuery.forSlug(Astro.params.slug, BUILD_DATE);
const { region } = page;
const labels = ui.regions;
const path = routes.region(region.slug);
const { profile } = region;
const description = labels.pageDescription(
  region.name,
  page.produce.length,
  page.farms.length,
  profile,
);
const linkedRegions = (await regionPagesQuery.overview())
  .filter((summary) => summary.hasPage && summary.region.slug !== region.slug)
  .map((summary) => ({ region: summary.region, href: routes.region(summary.region.slug) }));
const placeName = labels.placeName(region.name);
const jsonLd = [
  administrativeAreaJsonLd({
    siteUrl: requireSiteUrl(Astro.site),
    path,
    name: region.name,
    description,
    country: labels.country,
  }),
];
---

<BaseLayout
  title={labels.pageTitle(region.name)}
  description={description}
  path={path}
  breadcrumbs={[
    { name: ui.breadcrumbs.home, path: routes.home },
    { name: labels.heading, path: routes.regions },
    { name: placeName, path },
  ]}
  jsonLd={jsonLd}
>
  <h1>{placeName}</h1>
  <p class="region__intro">{labels.pageIntro(page.produce.length, page.farms.length)}</p>
  <ProvinceMap
    regions={[region]}
    links={linkedRegions}
    caption={labels.mapCaptionFor(region.name)}
  />

  {profile !== undefined && page.areaRank !== undefined && (
    <section aria-labelledby="region-profile">
      <h2 class="section-heading" id="region-profile">
        {labels.profile.heading}
      </h2>
      <p class="region__profile">{labels.profile.summary(profile, page.areaRank)}</p>
      <p class="region__sources-label">{labels.profile.sourcesLabel}</p>
      <ul class="region__sources">
        {profile.sources.map((source) => (
          <li>
            <a href={source.url}>{source.name}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="region-produce">
    <h2 class="section-heading" id="region-produce">
      {labels.growsHeading}
    </h2>
    {page.produce.length === 0 ? (
      <p>{labels.noProduce}</p>
    ) : (
      <ul class="region__produce" role="list">
        {page.produce.map(({ produce, note }) => (
          <li>
            <a href={routes.produce(produce)}>{produce.name}</a>
            {labels.noteSeparator}
            <span class="region__note">{note}</span>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section aria-labelledby="region-farms">
    <h2 class="section-heading" id="region-farms">
      {labels.farmsHeading}
    </h2>
    <FarmList farms={page.farms} currentRegionSlug={region.slug} emptyText={labels.noFarms} />
  </section>
</BaseLayout>

<style>
  h1 {
    margin-block: var(--space-6) var(--space-3);
  }

  .region__intro {
    max-width: var(--reading-width);
    margin-bottom: var(--space-4);
  }

  .region__profile {
    max-width: var(--reading-width);
  }

  .region__sources-label {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .region__sources {
    display: grid;
    gap: var(--space-1);
    max-width: var(--reading-width);
    font-size: var(--font-size-sm);
    overflow-wrap: anywhere;
  }

  .region__produce {
    display: grid;
    max-width: var(--reading-width);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .region__produce li {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
  }

  .region__produce a {
    color: var(--color-text);
    font-weight: 700;
  }

  .region__note {
    color: var(--color-text-muted);
  }
</style>
