---
import type { FarmWithRegion } from '@composition/ProduceDetailsQuery';
import type { OrganicProduction } from '@contexts/catalog';
import { ui } from '@i18n/bg';
import { routes } from '@components/layout/routes';
import FarmCard from './FarmCard.astro';

/**
 * The farms that sell a produce. Starts with the produce's organic status in Bulgaria when known.
 * When a farm is certified organic, farms are split into an organic and an other group, each
 * under its own heading; otherwise they form one list. Without farms it shows `emptyText`. Ends
 * with a link to the section on adding a farm.
 */
interface Props {
  farms: ReadonlyArray<FarmWithRegion>;
  organic?: OrganicProduction | undefined;
  /** Slug of the region whose page shows the list; its name is not linked on the cards. */
  currentRegionSlug?: string | undefined;
  /** Text shown when there are no farms; defaults to the produce page's text. */
  emptyText?: string | undefined;
}

const { farms, organic, currentRegionSlug, emptyText } = Astro.props;
const labels = ui.produce.farms;
const organicFarms = farms.filter((entry) => entry.certifiedOrganic);
const otherFarms = farms.filter((entry) => !entry.certifiedOrganic);
const groups =
  organicFarms.length === 0
    ? []
    : [
        { id: 'farms-organic', heading: labels.organicGroup, farms: organicFarms },
        { id: 'farms-other', heading: labels.otherGroup, farms: otherFarms },
      ].filter((group) => group.farms.length > 0);
---

{organic !== undefined && (
  <p class="organic-status">
    <strong>{labels.organicStatusLabel}</strong> {labels.organicStatus[organic.availability]}{' '}
    {organic.note}
  </p>
)}
{farms.length === 0 && <p>{emptyText ?? labels.empty}</p>}
{farms.length > 0 && groups.length === 0 && (
  <ul class="farms" role="list">
    {farms.map((entry) => (
      <FarmCard {...entry} headingLevel={3} currentRegionSlug={currentRegionSlug} />
    ))}
  </ul>
)}
{groups.map((group) => (
  <section class="farm-group" aria-labelledby={group.id}>
    <h3 id={group.id}>{group.heading}</h3>
    <ul class="farms" role="list">
      {group.farms.map((entry) => (
        <FarmCard {...entry} headingLevel={4} currentRegionSlug={currentRegionSlug} />
      ))}
    </ul>
  </section>
))}
<p class="farm-list__add">
  <a href={routes.addFarm}>{labels.addFarmLink}</a>
</p>

<style>
  .farms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .farm-list__add {
    margin-top: var(--space-3);
  }

  .farm-group {
    display: grid;
    gap: var(--space-3);
  }

  .organic-status {
    max-width: var(--reading-width);
  }
</style>
