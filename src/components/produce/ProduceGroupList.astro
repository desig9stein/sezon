---
import ProduceCard from '@components/produce/ProduceCard.astro';
import type { Produce } from '@contexts/catalog';
import type { Month, SeasonLevel } from '@contexts/seasonality';

/**
 * One labelled group of produce: `plate` shows surface panels of equal size,
 * `index` shows quiet rows on hairlines. `levelOf` gives each card's badge level and
 * `levelFrom` marks it as applying from a later month; `stripMonth` adds each produce's
 * year strip with that month marked. The first plate's photo loads eagerly. `headingLevel` sets the
 * group heading (default `h2`); the cards' headings are one level below.
 */
interface Props {
  id: string;
  heading: string;
  items: ReadonlyArray<Produce>;
  variant: 'plate' | 'index';
  levelOf: (produce: Produce) => SeasonLevel | undefined;
  levelFrom?: Month | undefined;
  stripMonth?: Month | undefined;
  /** Level of the group heading; an `h2` group is a named landmark, an `h3` group is not. */
  headingLevel?: 2 | 3;
}

const LANDMARK_HEADING_LEVEL = 2;
const {
  id,
  heading,
  items,
  variant,
  levelOf,
  levelFrom,
  stripMonth,
  headingLevel = LANDMARK_HEADING_LEVEL,
} = Astro.props;
const Heading = `h${headingLevel}` as const;
const cardHeadingLevel = headingLevel === LANDMARK_HEADING_LEVEL ? 3 : 4;
---

<section
  class="group"
  aria-labelledby={headingLevel === LANDMARK_HEADING_LEVEL ? id : undefined}
  data-variant={variant}
>
  <Heading id={id}>{heading}</Heading>
  <ul class="group__list" role="list">
    {items.map((produce, index) => (
      <li>
        <ProduceCard
          produce={produce}
          level={levelOf(produce)}
          levelFrom={levelFrom}
          variant={variant}
          priority={index === 0}
          stripMonth={stripMonth}
          headingLevel={cardHeadingLevel}
        />
      </li>
    ))}
  </ul>
</section>

<style>
  .group {
    margin-top: var(--space-12);
  }

  .group__list {
    display: grid;
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .group[data-variant='plate'] .group__list {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
  }

  .group[data-variant='index'] .group__list {
    column-gap: var(--space-8);
  }

  @media (min-width: 40rem) {
    .group[data-variant='index'] .group__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
