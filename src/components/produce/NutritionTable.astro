---
import type { Macronutrient, NutritionFacts } from '@contexts/catalog';
import type { ResolvedMicronutrient } from '@composition/ProduceDetailsQuery';
import { routes } from '@components/layout/routes';
import ScrollTable from '@components/ui/ScrollTable.astro';
import { palettes } from '@design/tokens';
import { formatNumber, ui } from '@i18n/bg';

/**
 * Nutrition values per 100 g with % of the EU reference intake and the data source.
 * Micronutrient rows link to their nutrient page. Each percentage is followed by a decorative bar
 * filled to the percentage, capped at 100.
 */
interface Props {
  nutrition: NutritionFacts;
  micronutrients: ReadonlyArray<ResolvedMicronutrient>;
}

interface Row {
  readonly label: string;
  readonly value: string;
  readonly percent: number | undefined;
  readonly href?: string;
}

const BAR_SCALE = 100;
const BAR_HEIGHT = 8;
const BAR_WIDTH = 64;
const ink = palettes.light;

const { nutrition, micronutrients } = Astro.props;
const labels = ui.produce.nutrition;
const { units } = labels;
const macroRow = (macro: Macronutrient, label: string, unit: string): Row[] => {
  const value = nutrition[macro];
  return value === undefined
    ? []
    : [
        {
          label,
          value: `${formatNumber(value)} ${unit}`,
          percent: nutrition.percentOfReferenceIntake(macro),
        },
      ];
};
const rows: ReadonlyArray<Row> = [
  ...macroRow('energyKcal', labels.energy, units.kcal),
  ...macroRow('proteinG', labels.protein, units.g),
  ...macroRow('fatG', labels.fat, units.g),
  ...macroRow('carbohydrateG', labels.carbohydrate, units.g),
  ...macroRow('sugarsG', labels.sugars, units.g),
  ...macroRow('fiberG', labels.fiber, units.g),
  ...micronutrients.map(({ nutrient, amount, percentOfReferenceIntake }) => ({
    label: nutrient.name,
    href: routes.nutrient(nutrient.slug),
    value: `${formatNumber(amount)} ${units[nutrient.unit]}`,
    percent: percentOfReferenceIntake,
  })),
];
---

<ScrollTable captionId="nutrition-caption">
  <table class="nutrition">
    <caption id="nutrition-caption">{labels.caption}</caption>
    <thead>
      <tr>
        <th scope="col">{labels.nutrient}</th>
        <th scope="col">{labels.amount}</th>
        <th scope="col">
          {labels.percent} <abbr title={labels.percentTitle}>{labels.percentAbbreviation}</abbr>
        </th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">
            {row.href === undefined ? row.label : <a href={row.href}>{row.label}</a>}
          </th>
          <td>{row.value}</td>
          <td>
            {row.percent === undefined ? (
              <>
                <span aria-hidden="true">–</span>
                <span class="visually-hidden">{labels.noReferenceIntake}</span>
              </>
            ) : (
              <span class="nutrition__percent">
                {`${row.percent}%`}
                <svg
                  class="nutrition__bar"
                  aria-hidden="true"
                  focusable="false"
                  width={BAR_WIDTH}
                  height={BAR_HEIGHT}
                  viewBox={`0 0 ${BAR_SCALE} ${BAR_HEIGHT}`}
                  preserveAspectRatio="none"
                >
                  <rect
                    class="nutrition__bar-track"
                    width={BAR_SCALE}
                    height={BAR_HEIGHT}
                    fill={ink.rule}
                  />
                  <rect
                    class="nutrition__bar-fill"
                    width={Math.min(row.percent, BAR_SCALE)}
                    height={BAR_HEIGHT}
                    fill={ink.accent}
                  />
                </svg>
              </span>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</ScrollTable>
<p class="nutrition__note">
  {labels.sourcePrefix} <a href={nutrition.source.url}>{nutrition.source.name}</a>.
  {labels.referenceNote}
</p>

<style>
  .nutrition {
    min-width: 18rem;
  }

  .nutrition__percent {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-variant-numeric: tabular-nums;
  }

  .nutrition__bar-track {
    fill: var(--color-rule);
  }

  .nutrition__bar-fill {
    fill: var(--color-accent);
  }

  @media print {
    .nutrition__bar-track {
      fill: none;
      stroke: var(--print-ink);
    }

    .nutrition__bar-fill {
      fill: var(--print-ink);
    }
  }

  .nutrition__note {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
