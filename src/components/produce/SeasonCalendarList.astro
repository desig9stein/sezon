---
import { routes } from '@components/layout/routes';
import LevelMark from '@components/season/LevelMark.astro';
import MonthAbbr from '@components/season/MonthAbbr.astro';
import { GROWING_ACTIVITIES, type Produce } from '@contexts/catalog';
import { Month } from '@contexts/seasonality';
import { ui } from '@i18n/bg';

/**
 * Twelve-month season strip of one produce: each month links to its month page and shows its
 * abbreviation, the level glyph and the level text on the level's tint; the current month is
 * outlined. When the produce's growing guide names at least one month, a labelled garden row
 * under it lists the activities (sow, transplant, plant) of each month.
 */
interface Props {
  produce: Produce;
  currentMonth: Month;
}

const { produce, currentMonth } = Astro.props;
const GARDEN_LABEL_ID = 'garden-label';
const months = Month.all().map((month) => ({ month, level: produce.levelIn(month) }));
const { growing } = produce;
const garden = ui.produce.garden;
const allGardenMonths =
  growing === undefined
    ? []
    : Month.all().map((month) => ({
        month,
        activities: GROWING_ACTIVITIES.filter((activity) =>
          growing.monthsOf(activity).includes(month),
        ).map((activity) => ui.produce.growingActivities[activity]),
      }));
const gardenMonths = allGardenMonths.some(({ activities }) => activities.length > 0)
  ? allGardenMonths
  : [];
---

<ul class="calendar" role="list">
  {months.map(({ month, level }) => (
    <li class="calendar__month" data-level={level?.value ?? 'none'}>
      <a href={routes.month(month)} aria-current={month === currentMonth ? 'date' : undefined}>
        <span class="calendar__name">
          <MonthAbbr month={month} />
        </span>
        <span class="calendar__glyph">
          <LevelMark level={level} />
        </span>
        <span class="calendar__level">
          {level === undefined ? ui.produce.outOfSeason : ui.seasonLevels[level.value]}
        </span>
      </a>
    </li>
  ))}
</ul>
{gardenMonths.length > 0 && (
  <>
    <p id={GARDEN_LABEL_ID} class="calendar__garden-label">
      {garden.label}
    </p>
    <ul class="calendar calendar--garden" role="list" aria-labelledby={GARDEN_LABEL_ID}>
      {gardenMonths.map(({ month, activities }) => (
        <li class="calendar__month" data-active={activities.length > 0 ? 'true' : 'false'}>
          <span class="calendar__name">
            <MonthAbbr month={month} />
          </span>
          <span class="calendar__level">
            {activities.length === 0 ? (
              <>
                <span aria-hidden="true">–</span>
                <span class="visually-hidden">{garden.none}</span>
              </>
            ) : (
              activities.join(garden.separator)
            )}
          </span>
        </li>
      ))}
    </ul>
  </>
)}

<style>
  .calendar {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2px;
    padding: 0;
    list-style: none;
  }

  .calendar__month a,
  .calendar--garden .calendar__month {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: var(--space-1);
    height: 100%;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-1);
    color: var(--color-text-muted);
    background: var(--color-surface);
    text-align: center;
    text-decoration: none;
  }

  .calendar__garden-label {
    margin-top: var(--space-3);
    font-weight: 700;
  }

  .calendar--garden .calendar__name {
    text-decoration: none;
  }

  .calendar--garden .calendar__month[data-active='true'] {
    color: var(--color-on-badge);
    background: var(--color-available);
  }

  .calendar--garden .calendar__month[data-active='true'] .calendar__level {
    font-weight: 700;
  }

  .calendar__month[data-level='peak'] a {
    color: var(--color-on-peak);
    background: var(--color-peak);
  }

  .calendar__month[data-level='available'] a {
    color: var(--color-on-badge);
    background: var(--color-available);
  }

  .calendar__month[data-level='storage'] a {
    color: var(--color-on-badge);
    background: var(--color-storage);
  }

  .calendar__month a[aria-current='date'] {
    box-shadow:
      inset 0 0 0 2px var(--color-background),
      inset 0 0 0 5px var(--color-accent);
    font-weight: 700;
  }

  .calendar__month a:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--color-background);
  }

  .calendar__month a[aria-current='date']:focus-visible {
    box-shadow:
      0 0 0 2px var(--color-background),
      inset 0 0 0 2px var(--color-background),
      inset 0 0 0 5px var(--color-accent);
  }

  @media print {
    .calendar__month a,
    .calendar__month[data-level] a,
    .calendar--garden .calendar__month,
    .calendar--garden .calendar__month[data-active='true'] {
      border: 1px solid var(--print-ink);
      color: var(--print-ink);
      background: none;
    }
  }

  .calendar__name {
    font-weight: 600;
    text-decoration: underline;
  }

  .calendar__level {
    font-size: var(--font-size-sm);
    line-height: 1.2;
    hyphens: auto;
  }

  @media (max-width: 60rem) {
    .calendar {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .calendar {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
