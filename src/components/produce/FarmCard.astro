---
import type { Farm } from '@contexts/farms';
import type { Region } from '@contexts/geography';
import FarmContacts from '@components/farms/FarmContacts.astro';
import FarmLabels from '@components/farms/FarmLabels.astro';
import { routes } from '@components/layout/routes';

/**
 * One farm as a list item: name (heading at `headingLevel`, linked to the farm page), province
 * (linked to its page unless it is `currentRegionSlug`), labels, description and contact links.
 */
interface Props {
  farm: Farm;
  region: Region;
  certifiedOrganic: boolean;
  headingLevel: 3 | 4;
  /** Slug of the region whose page shows the card; the province is then not linked. */
  currentRegionSlug?: string | undefined;
}

const { farm, region, certifiedOrganic, headingLevel, currentRegionSlug } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<li class="farm">
  <Heading class="farm__name">
    <a href={routes.farm(farm.slug)}>{farm.name}</a>
  </Heading>
  <p class="farm__meta">
    {region.slug === currentRegionSlug ? (
      <span>{region.name}</span>
    ) : (
      <a href={routes.region(region.slug)}>{region.name}</a>
    )}
    <FarmLabels farm={farm} certifiedOrganic={certifiedOrganic} />
  </p>
  <p>{farm.description}</p>
  <FarmContacts farm={farm} />
</li>

<style>
  .farm {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .farm__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
