---
import SeasonGroupsList from '@components/produce/SeasonGroupsList.astro';
import type { SectionIndex } from '@contexts/catalog';
import { ui } from '@i18n/bg';

/**
 * Every produce of one kind in labelled season groups, introduced by the section intro, or the
 * section empty text when the kind has no produce.
 */
interface Props {
  section: SectionIndex;
}

const { section } = Astro.props;
---

<SeasonGroupsList
  groups={section}
  intro={ui.sections.intro(section.kind, section.month)}
  empty={ui.sections.empty}
  idPrefix="section"
/>
