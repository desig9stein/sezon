---
import type { Region } from '@contexts/geography';
import { palettes } from '@design/tokens';
import { ui } from '@i18n/bg';
import { BrokenReferenceError } from '@shared/domain/errors';
import provinceMap from '../../assets/map/provinces.json';

/**
 * Map of Bulgaria's 28 provinces as an inline SVG. `regions` are marked with the accent hatch; the
 * provinces in `links` that are not marked get a light hatch; the rest use the rule colour, with
 * borders in the border colour. Without links the SVG is an image named by its title. With links it
 * is a named group: the drawn provinces are hidden from assistive technology and the links are a
 * layer above them, in Bulgarian name order, each named after its province and showing a surface
 * and focus ring on focus. The caption describes the map (`caption`, or the produce page's default)
 * and credits Natural Earth. The SVG keeps its size without CSS.
 * @throws BrokenReferenceError when a marked or linked region has no province on the map.
 */
interface ProvinceLink {
  readonly region: Region;
  readonly href: string;
}

interface Props {
  regions: ReadonlyArray<Region>;
  links?: ReadonlyArray<ProvinceLink>;
  caption?: string;
}

/** Rendered width without CSS; the height follows the viewBox ratio. */
const WIDTH = 320;
const STROKE_WIDTH = 1;
const TITLE_ID = 'province-map-title';
const HATCH_ID = 'province-map-hatch';
const LINKED_ID = 'province-map-linked';
const HATCH_SIZE = 6;
const HATCH_LINE_WIDTH = 1.5;
const LINKED_LINE_WIDTH = 0.75;
const HATCH_ANGLE = 45;
const [, , viewBoxWidth = 1, viewBoxHeight = 0] = provinceMap.viewBox.split(' ').map(Number);
const HEIGHT = Math.round((WIDTH * viewBoxHeight) / viewBoxWidth);
const ink = palettes.light;
const paths: Readonly<Record<string, string>> = provinceMap.provinces;
const collator = new Intl.Collator('bg');

const { regions, links = [], caption } = Astro.props;
const marked = new Set(regions.map((region) => region.slug));
const linkBySlug = new Map(links.map((link) => [link.region.slug, link]));
for (const slug of [...marked, ...linkBySlug.keys()]) {
  if (paths[slug] === undefined) throw new BrokenReferenceError(`No province on the map: ${slug}`);
}
const isLinked = linkBySlug.size > 0;
const label = ui.produce.map.label(regions.map((region) => region.name));
const labels = ui.produce.map;
const fillOf = (slug: string) => {
  if (marked.has(slug)) return `url(#${HATCH_ID})`;
  if (linkBySlug.has(slug)) return `url(#${LINKED_ID})`;
  return ink.rule;
};
const provinces = Object.entries(paths).map(([slug, d]) => ({ slug, d }));
const linkLayer = [...links]
  .sort((a, b) => collator.compare(a.region.name, b.region.name))
  .map((link) => ({ ...link, d: paths[link.region.slug] ?? '' }));
---

<figure class="province-map">
  <svg
    role={isLinked ? 'group' : 'img'}
    aria-labelledby={TITLE_ID}
    width={WIDTH}
    height={HEIGHT}
    viewBox={provinceMap.viewBox}
    stroke={ink.border}
    stroke-width={STROKE_WIDTH}
    stroke-linejoin="round"
  >
    <title id={TITLE_ID}>{label}</title>
    <defs>
      <pattern
        id={HATCH_ID}
        width={HATCH_SIZE}
        height={HATCH_SIZE}
        patternUnits="userSpaceOnUse"
        patternTransform={`rotate(${HATCH_ANGLE})`}
      >
        <rect
          class="province-map__hatch-fill"
          width={HATCH_SIZE}
          height={HATCH_SIZE}
          fill={ink.accent}
          stroke="none"
        />
        <line
          class="province-map__hatch-line"
          x1="0"
          y1="0"
          x2="0"
          y2={HATCH_SIZE}
          stroke={ink.surface}
          stroke-width={HATCH_LINE_WIDTH}
        />
      </pattern>
      <pattern
        id={LINKED_ID}
        width={HATCH_SIZE}
        height={HATCH_SIZE}
        patternUnits="userSpaceOnUse"
        patternTransform={`rotate(${HATCH_ANGLE})`}
      >
        <rect
          class="province-map__linked-fill"
          width={HATCH_SIZE}
          height={HATCH_SIZE}
          fill={ink.rule}
          stroke="none"
        />
        <line
          class="province-map__linked-line"
          x1="0"
          y1="0"
          x2="0"
          y2={HATCH_SIZE}
          stroke={ink.accent}
          stroke-width={LINKED_LINE_WIDTH}
        />
      </pattern>
    </defs>
    <g aria-hidden={isLinked ? 'true' : undefined}>
      {provinces.map(({ slug, d }) => (
        <path
          class="province-map__province"
          data-region={slug}
          data-marked={marked.has(slug) ? 'true' : 'false'}
          data-linked={linkBySlug.has(slug) ? 'true' : 'false'}
          fill={fillOf(slug)}
          d={d}
        />
      ))}
    </g>
    {linkLayer.map(({ region, href, d }) => (
      <a href={href} aria-label={region.name}>
        <path class="province-map__hit" fill="transparent" stroke="none" d={d} />
        <path
          class="province-map__ring province-map__ring--outer"
          fill="none"
          stroke="none"
          d={d}
        />
        <path
          class="province-map__ring province-map__ring--inner"
          fill="none"
          stroke="none"
          d={d}
        />
      </a>
    ))}
  </svg>
  <figcaption>
    {caption ?? labels.caption}
    {labels.creditPrefix} <a href={labels.creditUrl}>{labels.creditName}</a>
    {labels.creditSuffix}
  </figcaption>
</figure>

<style>
  .province-map {
    display: grid;
    gap: var(--space-2);
    max-width: 30rem;
    margin: 0;
  }

  .province-map svg {
    width: 100%;
    height: auto;
    stroke: var(--color-border);
  }

  .province-map__province {
    fill: var(--color-rule);
  }

  .province-map__province[data-marked='true'] {
    fill: url(#province-map-hatch);
  }

  .province-map__hatch-fill {
    fill: var(--color-accent);
  }

  .province-map__hatch-line {
    stroke: var(--color-surface);
  }

  .province-map__province[data-linked='true'][data-marked='false'] {
    fill: url(#province-map-linked);
  }

  .province-map__linked-fill {
    fill: var(--color-rule);
  }

  .province-map__linked-line {
    stroke: var(--color-accent);
  }

  .province-map a {
    outline: none;
  }

  .province-map a:hover .province-map__ring--inner {
    stroke: var(--color-text);
    stroke-width: 2;
  }

  .province-map a:focus-visible .province-map__ring--outer {
    stroke: var(--color-surface);
    stroke-width: 7;
  }

  .province-map a:focus-visible .province-map__ring--inner {
    stroke: var(--color-focus);
    stroke-width: 3;
  }

  .province-map figcaption {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  @media print {
    .province-map svg {
      stroke: var(--print-ink);
    }

    .province-map__province {
      fill: none;
    }

    .province-map__province[data-marked='true'] {
      fill: var(--print-ink);
    }
  }
</style>
