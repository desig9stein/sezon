---
import { Picture } from 'astro:assets';
import SeasonBadge from '@components/season/SeasonBadge.astro';
import { routes } from '@components/layout/routes';
import type { Produce } from '@contexts/catalog';
import type { Month, SeasonLevel } from '@contexts/seasonality';
import { ui } from '@i18n/bg';
import { displayHeight } from './photo';

/**
 * One produce as a plate (name, Latin name, kind, badge and summary on a surface panel) or as an
 * index row (name, Latin name and badge on a hairline). A plate shows the produce photo first, as
 * decoration because the name says what it shows; `priority` loads it eagerly for the first plate
 * of a page. `levelFrom` marks the badge level as applying from a later month.
 */
interface Props {
  produce: Produce;
  level?: SeasonLevel | undefined;
  levelFrom?: Month | undefined;
  headingLevel?: 2 | 3 | 4;
  variant?: 'plate' | 'index';
  priority?: boolean;
}

const PLATE_DISPLAY_WIDTH = 640;
const PLATE_WIDTHS = [320, 480, 640, 720, 960];
/** `sizes` of the first plate, which spans two grid columns from 40 rem. */
const LEAD_PLATE_SIZES =
  '(min-width: 60rem) 34rem, (min-width: 40rem) calc(100vw - 6rem), calc(100vw - 4rem)';
/** `sizes` of the other plates, one 17 rem grid column from 40 rem. */
const PLATE_SIZES = '(min-width: 40rem) 15rem, calc(100vw - 4rem)';

const {
  produce,
  level,
  levelFrom,
  headingLevel = 3,
  variant = 'plate',
  priority = false,
} = Astro.props;
const Heading = `h${headingLevel}` as const;
const photo = variant === 'plate' ? produce.photo : undefined;
---

<article class="produce-card" data-variant={variant}>
  {photo !== undefined && (
    <Picture
      class="produce-card__photo"
      src={photo.image}
      alt=""
      formats={['avif', 'webp']}
      width={PLATE_DISPLAY_WIDTH}
      height={displayHeight(photo.image, PLATE_DISPLAY_WIDTH)}
      widths={PLATE_WIDTHS}
      sizes={priority ? LEAD_PLATE_SIZES : PLATE_SIZES}
      quality={50}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
    />
  )}
  <Heading class="produce-card__name">
    <a href={routes.produce(produce)}>{produce.name}</a>
  </Heading>
  <p class="produce-card__meta">
    <i lang="la">{produce.latinName}</i>
    <span>{ui.produceKinds[produce.kind]}</span>
    {level !== undefined && <SeasonBadge level={level} fromMonth={levelFrom} />}
  </p>
  {variant === 'plate' && <p class="produce-card__summary">{produce.summary}</p>}
</article>

<style>
  .produce-card {
    display: grid;
    align-content: end;
    gap: var(--space-2);
    height: 100%;
  }

  .produce-card[data-variant='plate'] {
    min-height: 13rem;
    padding: var(--space-6) var(--space-4) var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .produce-card :global(.produce-card__photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-2);
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .produce-card[data-variant='index'] {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
  }

  .produce-card__name {
    font-size: var(--font-size-xl);
  }

  .produce-card[data-variant='index'] .produce-card__name {
    font-size: var(--font-size-lg);
  }

  .produce-card__name a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: var(--color-text);
  }

  .produce-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .produce-card__summary {
    max-width: 42ch;
    color: var(--color-text-muted);
  }
</style>
