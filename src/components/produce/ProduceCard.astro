---
import { Picture } from 'astro:assets';
import SeasonBadge from '@components/season/SeasonBadge.astro';
import YearStrip from '@components/season/YearStrip.astro';
import { routes } from '@components/layout/routes';
import type { Produce } from '@contexts/catalog';
import type { Month, SeasonLevel } from '@contexts/seasonality';
import { ui } from '@i18n/bg';
import { displayHeight } from './photo';

/**
 * One produce as a plate (name, Latin name, kind, badge and summary on a surface panel) or as an
 * index row (name, Latin name and badge on a hairline). A wild produce shows „Диворастящ“ after the
 * kind (spec 055). A plate shows the produce photo first, as
 * decoration because the name says what it shows; `priority` loads it eagerly for the first plate
 * of a page. `levelFrom` marks the badge level as applying from a later month; with
 * `stripMonth`, the produce's year strip follows the badge with that month marked.
 */
interface Props {
  produce: Produce;
  level?: SeasonLevel | undefined;
  levelFrom?: Month | undefined;
  headingLevel?: 2 | 3 | 4;
  variant?: 'plate' | 'index';
  priority?: boolean;
  stripMonth?: Month | undefined;
}

const PLATE_DISPLAY_WIDTH = 640;
const PLATE_WIDTHS = [320, 480, 640, 720, 960];
const PLATE_SIZES =
  '(min-width: 66rem) 22rem, (min-width: 44rem) calc(50vw - 4rem), calc(100vw - 4rem)';

const {
  produce,
  level,
  levelFrom,
  headingLevel = 3,
  variant = 'plate',
  priority = false,
  stripMonth,
} = Astro.props;
const Heading = `h${headingLevel}` as const;
const photo = variant === 'plate' ? produce.photo : undefined;
---

<article class="produce-card" data-variant={variant}>
  {photo !== undefined && (
    <Picture
      class="produce-card__photo"
      src={photo.image}
      alt=""
      formats={['avif', 'webp']}
      width={PLATE_DISPLAY_WIDTH}
      height={displayHeight(photo.image, PLATE_DISPLAY_WIDTH)}
      widths={PLATE_WIDTHS}
      sizes={PLATE_SIZES}
      quality={40}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
    />
  )}
  <Heading class="produce-card__name">
    <a href={routes.produce(produce)}>{produce.name}</a>
  </Heading>
  <p class="produce-card__meta">
    {produce.latinName !== undefined && <i lang="la">{produce.latinName}</i>}
    <span>{ui.produceKinds[produce.kind]}</span>
    {produce.wild && <span class="produce-card__wild">{ui.produce.wild.label}</span>}
    {level !== undefined && <SeasonBadge level={level} fromMonth={levelFrom} />}
    {stripMonth !== undefined && <YearStrip produce={produce} current={stripMonth} />}
  </p>
  {variant === 'plate' && <p class="produce-card__summary">{produce.summary}</p>}
</article>

<style>
  .produce-card {
    display: grid;
    align-content: end;
    gap: var(--space-2);
    height: 100%;
  }

  .produce-card[data-variant='plate'] {
    align-content: start;
    min-height: 13rem;
    padding: var(--space-6) var(--space-4) var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .produce-card :global(.produce-card__photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-2);
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .produce-card[data-variant='index'] {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
  }

  .produce-card__name {
    font-size: var(--font-size-xl);
  }

  .produce-card[data-variant='index'] .produce-card__name {
    font-size: var(--font-size-lg);
  }

  .produce-card[data-variant='index'] .produce-card__meta {
    justify-content: flex-end;
    margin-inline-start: auto;
  }

  .produce-card__name a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: var(--color-text);
  }

  .produce-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .produce-card__wild {
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .produce-card__summary {
    max-width: 42ch;
    color: var(--color-text-muted);
  }
</style>
