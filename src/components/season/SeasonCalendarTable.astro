---
import { routes } from '@components/layout/routes';
import ScrollTable from '@components/ui/ScrollTable.astro';
import type { ProduceKind, SeasonCalendar } from '@contexts/catalog';
import { Month, SeasonLevel } from '@contexts/seasonality';
import { ui } from '@i18n/bg';
import LevelMark from './LevelMark.astro';
import MonthAbbr from './MonthAbbr.astro';

/**
 * Year-at-a-glance calendar of every produce against the 12 months: a legend, a jump list to the
 * kinds, then one section per kind with an `h2` and its own table (spec 059). Each cell shows the
 * level mark (decorative) and the level text (visually hidden). The tables share fixed column
 * widths so they line up. An empty calendar renders the empty message instead.
 */
interface Props {
  calendar: SeasonCalendar;
  currentMonth: Month;
}

const { calendar, currentMonth } = Astro.props;
const labels = ui.calendar;
const months = Month.all();
const sectionId = (kind: ProduceKind) => `kalendar-${routes.produceSection(kind)}`;
const captionId = (kind: ProduceKind) => `${sectionId(kind)}-caption`;
const levelLabel = (level: SeasonLevel | undefined) =>
  level === undefined ? ui.produce.outOfSeason : ui.seasonLevels[level.value];
const legend = [SeasonLevel.PEAK, SeasonLevel.AVAILABLE, SeasonLevel.STORAGE, undefined];
---

{calendar.groups.length === 0 ? (
  <p>{labels.empty}</p>
) : (
  <>
    <ul class="calendar-legend" role="list" aria-label={labels.legendHeading}>
      {legend.map((level) => (
        <li>
          <LevelMark level={level} /> {levelLabel(level)}
        </li>
      ))}
    </ul>
    <nav class="calendar-toc" aria-label={labels.toc}>
      <ul role="list">
        {calendar.groups.map((group) => (
          <li>
            <a href={`#${sectionId(group.kind)}`}>{ui.sections.names[group.kind]}</a>
          </li>
        ))}
      </ul>
    </nav>
    {calendar.groups.map((group) => (
      <section class="calendar-kind" aria-labelledby={sectionId(group.kind)}>
        <h2 id={sectionId(group.kind)}>
          <a href={routes.section(group.kind)}>{ui.sections.names[group.kind]}</a>
        </h2>
        <ScrollTable caption={labels.kindCaption(ui.sections.names[group.kind])}>
          <table class="year">
            <caption id={captionId(group.kind)}>
              {labels.kindCaption(ui.sections.names[group.kind])}
            </caption>
            <thead>
              <tr>
                <th scope="col">{labels.produceColumn}</th>
                {months.map((month) => (
                  <th scope="col" aria-current={month === currentMonth ? 'date' : undefined}>
                    <span>
                      <MonthAbbr month={month} />
                    </span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {group.produce.map((produce) => (
                <tr>
                  <th scope="row">
                    <a href={routes.produce(produce)}>{produce.name}</a>
                  </th>
                  {months.map((month) => {
                    const level = produce.levelIn(month);
                    return (
                      <td data-level={level?.value ?? 'none'}>
                        <LevelMark level={level} />
                        <span class="visually-hidden">{levelLabel(level)}</span>
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </ScrollTable>
      </section>
    ))}
  </>
)}

<style>
  .calendar-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    margin-block: var(--space-4);
    padding: 0;
    list-style: none;
    color: var(--color-text-muted);
  }

  .calendar-toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .calendar-toc a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-weight: 600;
  }

  .calendar-kind {
    margin-top: var(--space-6);
  }

  .calendar-kind h2 {
    margin-bottom: var(--space-2);
  }

  .year {
    min-width: 40rem;
    table-layout: fixed;
  }

  .year th[scope='col']:first-child {
    width: 10rem;
  }

  .year th[scope='row'] {
    position: sticky;
    inset-inline-start: 0;
    background: var(--color-background);
  }

  .year th[scope='col'] {
    font-weight: 600;
    text-align: center;
  }

  .year th[aria-current='date'] {
    color: var(--color-accent-text);
    background: var(--color-accent);
  }

  .year td {
    text-align: center;
  }

  .year td[data-level='peak'] {
    color: var(--color-on-peak);
    background: var(--color-peak);
  }

  .year td[data-level='available'] {
    color: var(--color-on-badge);
    background: var(--color-available);
  }

  .year td[data-level='storage'] {
    color: var(--color-on-badge);
    background: var(--color-storage);
  }

  .year td[data-level='none'] {
    color: var(--color-text-muted);
  }

  @media print {
    .calendar-legend {
      margin-block: var(--print-gap);
      color: var(--print-ink);
      font-size: var(--print-font-size);
    }

    .year {
      min-width: 0;
      font-size: var(--print-font-size);
      line-height: var(--print-table-line-height);
    }

    .year a {
      color: var(--print-ink);
    }

    .year thead {
      display: table-header-group;
    }

    .year tr {
      break-inside: avoid;
    }

    .calendar-toc {
      display: none;
    }

    .calendar-kind {
      margin-top: var(--print-gap);
    }

    .calendar-kind h2 {
      margin-bottom: 0;
      font-size: var(--print-heading-font-size);
      break-after: avoid;
    }

    .calendar-kind h2 a {
      color: var(--print-ink);
    }

    /* A scrolling box prints as one unbreakable block; let the table break across sheets so its
       heading, caption and month header stay with the first rows. */
    .calendar-kind :global(.table-scroll) {
      overflow: visible;
      break-before: avoid;
    }

    .calendar-kind caption,
    .year thead {
      break-after: avoid;
    }

    .year tbody tr:nth-child(-n + 2) {
      break-before: avoid;
    }

    .year th,
    .year td,
    .year th[scope='row'],
    .year th[aria-current='date'],
    .year td[data-level] {
      padding: var(--print-cell-padding);
      color: var(--print-ink);
      background: none;
    }

    .year th[aria-current='date'] {
      text-decoration: underline;
    }
  }
</style>
