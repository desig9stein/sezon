---
import { routes } from '@components/layout/routes';
import ScrollTable from '@components/ui/ScrollTable.astro';
import type { SeasonCalendar } from '@contexts/catalog';
import { Month, SeasonLevel } from '@contexts/seasonality';
import { ui } from '@i18n/bg';
import LevelMark from './LevelMark.astro';
import MonthAbbr from './MonthAbbr.astro';

/**
 * Year-at-a-glance table of every produce against the 12 months, grouped by kind. Each cell shows
 * the level mark (decorative) and the level text (visually hidden); a legend explains the marks.
 * An empty calendar renders the empty message instead.
 */
interface Props {
  calendar: SeasonCalendar;
  currentMonth: Month;
}

const { calendar, currentMonth } = Astro.props;
const labels = ui.calendar;
const months = Month.all();
const captionId = 'season-calendar-caption';
const levelLabel = (level: SeasonLevel | undefined) =>
  level === undefined ? ui.produce.outOfSeason : ui.seasonLevels[level.value];
const legend = [SeasonLevel.PEAK, SeasonLevel.AVAILABLE, SeasonLevel.STORAGE, undefined];
---

{calendar.groups.length === 0 ? (
  <p>{labels.empty}</p>
) : (
  <>
    <ul class="calendar-legend" role="list" aria-label={labels.legendHeading}>
      {legend.map((level) => (
        <li>
          <LevelMark level={level} /> {levelLabel(level)}
        </li>
      ))}
    </ul>
    <ScrollTable captionId={captionId}>
      <table class="year">
        <caption id={captionId}>{labels.caption}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.produceColumn}</th>
            {months.map((month) => (
              <th scope="col" aria-current={month === currentMonth ? 'date' : undefined}>
                <span>
                  <MonthAbbr month={month} />
                </span>
              </th>
            ))}
          </tr>
        </thead>
        {calendar.groups.map((group) => (
          <tbody>
            <tr>
              <th scope="rowgroup" colspan={months.length + 1}>
                <a href={routes.section(group.kind)}>{ui.sections.names[group.kind]}</a>
              </th>
            </tr>
            {group.produce.map((produce) => (
              <tr>
                <th scope="row">
                  <a href={routes.produce(produce)}>{produce.name}</a>
                </th>
                {months.map((month) => {
                  const level = produce.levelIn(month);
                  return (
                    <td data-level={level?.value ?? 'none'}>
                      <LevelMark level={level} />
                      <span class="visually-hidden">{levelLabel(level)}</span>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </ScrollTable>
  </>
)}

<style>
  .calendar-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    margin-block: var(--space-4);
    padding: 0;
    list-style: none;
    color: var(--color-text-muted);
  }

  .year {
    min-width: 40rem;
  }

  .year th[scope='row'] {
    position: sticky;
    inset-inline-start: 0;
    background: var(--color-background);
  }

  .year th[scope='col'] {
    font-weight: 600;
    text-align: center;
  }

  .year th[aria-current='date'] {
    color: var(--color-accent-text);
    background: var(--color-accent);
  }

  .year th[scope='rowgroup'] {
    padding-top: var(--space-4);
    font-size: var(--font-size-lg);
    font-weight: 700;
  }

  .year td {
    text-align: center;
  }

  .year td[data-level='peak'] {
    color: var(--color-on-peak);
    background: var(--color-peak);
  }

  .year td[data-level='available'] {
    color: var(--color-on-badge);
    background: var(--color-available);
  }

  .year td[data-level='storage'] {
    color: var(--color-on-badge);
    background: var(--color-storage);
  }

  .year td[data-level='none'] {
    color: var(--color-text-muted);
  }

  @media print {
    .calendar-legend {
      margin-block: var(--print-gap);
      color: var(--print-ink);
      font-size: var(--print-font-size);
    }

    .year {
      min-width: 0;
      font-size: var(--print-font-size);
      line-height: var(--print-table-line-height);
    }

    .year a {
      color: var(--print-ink);
    }

    .year thead {
      display: table-header-group;
    }

    .year tr {
      break-inside: avoid;
    }

    .year tr:has(th[scope='rowgroup']) {
      break-after: avoid;
    }

    .year th,
    .year td,
    .year th[scope='row'],
    .year th[scope='rowgroup'],
    .year th[aria-current='date'],
    .year td[data-level] {
      padding: var(--print-cell-padding);
      color: var(--print-ink);
      background: none;
    }

    .year th[aria-current='date'] {
      text-decoration: underline;
    }

    .year th[scope='rowgroup'] {
      font-size: var(--print-heading-font-size);
    }
  }
</style>
