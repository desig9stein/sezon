---
import { routes } from '@components/layout/routes';
import { Month } from '@contexts/seasonality';
import { ui } from '@i18n/bg';
import MonthAbbr from './MonthAbbr.astro';

/**
 * The twelve months as a ribbon of links to the month pages. Each link shows the month's first
 * three letters; the rest of the name is visually hidden. The current month is marked.
 */
interface Props {
  current: Month;
}

const { current } = Astro.props;
---

<nav class="ribbon" aria-label={ui.ribbon.label}>
  <ol class="ribbon__list">
    {Month.all().map((month) => (
      <li>
        <a href={routes.month(month)} aria-current={month === current ? 'date' : undefined}>
          <MonthAbbr month={month} />
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .ribbon__list {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--color-rule);
  }

  .ribbon__list li + li {
    border-inline-start: 1px solid var(--color-rule);
  }

  .ribbon__list a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .ribbon__list a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .ribbon__list a[aria-current='date'] {
    color: var(--color-accent-text);
    background: var(--color-accent);
    font-weight: 700;
  }

  @media (max-width: 40rem) {
    .ribbon__list {
      grid-template-columns: repeat(6, 1fr);
    }

    .ribbon__list li:nth-child(7) {
      border-inline-start: 0;
    }

    .ribbon__list li:nth-child(n + 7) {
      border-top: 1px solid var(--color-rule);
    }
  }
</style>
