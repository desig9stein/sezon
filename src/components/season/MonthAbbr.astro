---
import type { Month } from '@contexts/seasonality';
import { monthAbbreviation, monthRest } from '@i18n/bg';

/**
 * The month's first three letters, followed by the rest of its name hidden inline, so the
 * accessible name and the text without CSS are the whole month name.
 */
interface Props {
  month: Month;
}

const { month } = Astro.props;
const rest = monthRest(month);
---

{[monthAbbreviation(month), rest && <span class="visually-hidden-inline">{rest}</span>]}
