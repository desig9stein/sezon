---
import type { Month } from '@contexts/seasonality';
import { monthAbbreviation, monthRest } from '@i18n/bg';

/** The month's first three letters, followed by the rest of its name visually hidden. */
interface Props {
  month: Month;
}

const { month } = Astro.props;
const rest = monthRest(month);
---

{[monthAbbreviation(month), rest && <span class="visually-hidden">{rest}</span>]}
