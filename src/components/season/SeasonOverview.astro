---
import ProduceGroupList from '@components/produce/ProduceGroupList.astro';
import type { Produce, SeasonOverview } from '@contexts/catalog';
import type { Month, SeasonLevel } from '@contexts/seasonality';
import { ui } from '@i18n/bg';

/** Identifiers of the groups an overview can render. */
type GroupId = 'peak' | 'available' | 'comingSoon' | 'storage';

/**
 * Produce of one month grouped into labelled sections: peak, available, coming soon, storage.
 * `groups` limits and orders the sections; coming-soon badges name the month they apply from.
 */
interface Props {
  overview: SeasonOverview;
  groups?: ReadonlyArray<GroupId>;
}

interface Group {
  readonly id: GroupId;
  readonly heading: string;
  readonly items: ReadonlyArray<Produce>;
  readonly levelOf: (produce: Produce) => SeasonLevel | undefined;
  readonly levelFrom?: Month;
}

const { overview, groups: selected = ['peak', 'available', 'comingSoon', 'storage'] } = Astro.props;
const { month } = overview;
const next = month.next();
const allGroups: ReadonlyArray<Group> = [
  { id: 'peak', heading: ui.overview.peak, items: overview.peak, levelOf: (p) => p.levelIn(month) },
  {
    id: 'available',
    heading: ui.overview.available,
    items: overview.available,
    levelOf: (p) => p.levelIn(month),
  },
  {
    id: 'comingSoon',
    heading: ui.overview.comingSoon,
    items: overview.comingSoon,
    levelOf: (p) => p.levelIn(next),
    levelFrom: next,
  },
  {
    id: 'storage',
    heading: ui.overview.storage,
    items: overview.storage,
    levelOf: (p) => p.levelIn(month),
  },
];
const groups = selected
  .map((id) => allGroups.find((group) => group.id === id))
  .filter((group): group is Group => group !== undefined && group.items.length > 0);
---

{groups.length === 0 && <p>{ui.overview.empty}</p>}
{groups.map((group) => (
  <ProduceGroupList
    id={`group-${group.id}`}
    heading={group.heading}
    items={group.items}
    variant={group.id === 'peak' ? 'plate' : 'index'}
    levelOf={group.levelOf}
    levelFrom={group.levelFrom}
  />
))}
