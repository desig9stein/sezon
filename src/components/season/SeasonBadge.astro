---
import type { Month, SeasonLevel } from '@contexts/seasonality';
import { ui } from '@i18n/bg';

/**
 * Season level as a stamp (ADR-0006): the form carries the level, solid for peak, outlined for
 * available, hatched for storage, and the short word is always shown. With `fromMonth`, the
 * word states that the level applies from that month.
 */
interface Props {
  level: SeasonLevel;
  fromMonth?: Month | undefined;
}

const { level, fromMonth } = Astro.props;
const word = ui.stamp[level.value];
---

<span class="season-badge season-stamp" data-level={level.value}>
  <span class="season-stamp__word">
    {fromMonth === undefined ? word : ui.overview.fromMonth(fromMonth, word)}
  </span>
</span>

<style>
  .season-stamp {
    display: inline-flex;
    align-items: center;
    padding: 0.2em 0.5em;
    border: 2px solid var(--color-accent);
    color: var(--color-accent);
    background: var(--color-surface);
    font-family: var(--font-family-display);
    font-size: var(--font-size-sm);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .season-stamp[data-level='peak'] {
    border-color: var(--color-peak);
    color: var(--color-on-peak);
    background: var(--color-peak);
  }

  .season-stamp[data-level='storage'] {
    padding: 0.2em;
    color: var(--color-text);
    background: repeating-linear-gradient(
      135deg,
      var(--color-accent) 0 1px,
      var(--color-surface) 1px 5px
    );
  }

  .season-stamp[data-level='storage'] .season-stamp__word {
    padding-inline: 0.3em;
    background: var(--color-surface);
  }

  @media print {
    .season-stamp,
    .season-stamp[data-level] {
      border-color: var(--print-ink);
      color: var(--print-ink);
      background: none;
    }

    .season-stamp[data-level='peak'] {
      border-width: 3px;
    }

    .season-stamp[data-level='storage'] {
      border-style: dashed;
    }
  }
</style>
