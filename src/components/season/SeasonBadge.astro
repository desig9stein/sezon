---
import type { Month, SeasonLevel } from '@contexts/seasonality';
import { ui } from '@i18n/bg';
import LevelMark from './LevelMark.astro';

/**
 * Season level shown as a decorative mark plus a visible text label on a level-coloured badge.
 * With `fromMonth`, the label states that the level applies from that month.
 */
interface Props {
  level: SeasonLevel;
  fromMonth?: Month | undefined;
}

const { level, fromMonth } = Astro.props;
const label = ui.seasonLevels[level.value];
---

<span class="season-badge" data-level={level.value}>
  <LevelMark level={level} />
  {fromMonth === undefined ? label : ui.overview.fromMonth(fromMonth, label)}
</span>

<style>
  .season-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    color: var(--color-on-badge);
    font-size: var(--font-size-sm);
    font-weight: 600;
    line-height: 1.2;
  }

  .season-badge[data-level='peak'] {
    color: var(--color-on-peak);
    background: var(--color-peak);
  }

  .season-badge[data-level='available'] {
    background: var(--color-available);
  }

  .season-badge[data-level='storage'] {
    background: var(--color-storage);
  }
</style>
