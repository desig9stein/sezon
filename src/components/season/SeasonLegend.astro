---
import { SeasonLevel } from '@contexts/seasonality';
import { ui } from '@i18n/bg';
import SeasonBadge from './SeasonBadge.astro';

/**
 * Explains the season stamps in plain words after each stamp, what „out of season“ means, and how
 * to read the year strip.
 */
const entries = [
  { level: SeasonLevel.PEAK, text: ui.legend.peak },
  { level: SeasonLevel.AVAILABLE, text: ui.legend.available },
  { level: SeasonLevel.STORAGE, text: ui.legend.storage },
];
---

<aside class="season-legend" aria-label={ui.legend.label}>
  <ul role="list">
    {entries.map(({ level, text }) => (
      <li>
        <SeasonBadge level={level} />
        <span class="season-legend__text">{text}</span>
      </li>
    ))}
    <li>
      <svg
        class="season-legend__cell"
        width="12"
        height="16"
        viewBox="0 0 12 16"
        aria-hidden="true"
      >
        <rect x="2" y="12" width="8" height="2" />
      </svg>
      <span class="season-legend__text">{ui.legend.outOfSeason}</span>
    </li>
    <li>
      <span class="season-legend__text">{ui.legend.strip}</span>
    </li>
  </ul>
</aside>

<style>
  .season-legend {
    margin-top: var(--space-6);
  }

  .season-legend ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
    font-size: var(--font-size-sm);
  }

  .season-legend li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .season-legend__cell rect {
    fill: var(--color-border);
  }

  .season-legend__text {
    color: var(--color-text-muted);
  }
</style>
