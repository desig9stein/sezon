---
import { ui } from '@i18n/bg';
import { CALENDAR_AREAS, CATALOG_AREAS, routes } from './routes';

/**
 * Site banner on the stamp-blue shell: the logo, which links to the home page, and five
 * navigation links (catalogue, calendar, farms, recipes, search). The current page gets
 * `aria-current="page"` (the logo on the home page); the link whose area contains the page gets
 * `aria-current="true"`. Below 40rem the links take their own row under the logo.
 */
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const NO_AREAS: ReadonlyArray<string> = [];
const links = [
  { href: routes.catalog, label: ui.nav.catalog, areas: CATALOG_AREAS },
  { href: routes.calendar, label: ui.calendar.navLabel, areas: CALENDAR_AREAS },
  { href: routes.farms, label: ui.nav.farms, areas: NO_AREAS },
  { href: routes.recipes, label: ui.nav.recipes, areas: NO_AREAS },
  { href: routes.search, label: ui.search.navLabel, areas: NO_AREAS },
];

const within = (path: string, prefix: string) => path === prefix || path.startsWith(`${prefix}/`);

/** `page` for the current page, `true` for the area that contains it, otherwise nothing. */
const currentOf = (link: (typeof links)[number]): 'page' | 'true' | undefined => {
  if (link.href === currentPath) return 'page';
  if (within(currentPath, link.href)) return 'true';
  return link.areas.some((area) => within(currentPath, area)) ? 'true' : undefined;
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a
      class="site-header__logo"
      href={routes.home}
      aria-label={ui.homeLinkLabel}
      aria-current={currentPath === routes.home ? 'page' : undefined}
    >
      {ui.siteName}
    </a>
    <nav aria-label={ui.nav.label}>
      <ul class="site-header__nav" role="list">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={currentOf(link)}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    color: var(--color-on-shell);
    background: var(--color-shell);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-4);
    padding-block: var(--space-1);
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: inherit;
    font-weight: 600;
    text-decoration-color: transparent;
    text-underline-offset: 0.35em;
  }

  .site-header__nav a:hover {
    text-decoration-color: currentColor;
  }

  .site-header__nav a[aria-current],
  .site-header__logo[aria-current] {
    text-decoration-color: var(--color-focus-on-shell);
    text-decoration-thickness: 3px;
  }

  .site-header__nav a[aria-current='true'] {
    text-decoration-style: dotted;
  }

  .site-header a:focus-visible {
    outline-color: var(--color-focus-on-shell);
  }

  .site-header__logo[aria-current] {
    text-decoration-line: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 39.99rem) {
    .site-header nav {
      flex-basis: 100%;
    }

    .site-header__nav {
      justify-content: space-between;
      gap: 0 var(--space-2);
      font-size: var(--font-size-sm);
    }
  }
</style>
