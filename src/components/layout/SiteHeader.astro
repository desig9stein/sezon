---
import { ui } from '@i18n/bg';
import { routes } from './routes';

/**
 * Site banner on the stamp-blue shell: the logo link and four navigation links. The current page
 * gets `aria-current="page"`; the link whose area contains the page gets `aria-current="true"`.
 */
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

/** Path prefixes that belong to each navigation area besides the link's own path. */
const CATALOG_AREAS = ['/plodove', '/zelenchutsi', '/podpravki', '/yadki', '/grupi', '/nutrienti'];
const CALENDAR_AREAS = ['/sezon'];

const links = [
  { href: routes.home, label: ui.nav.now, areas: [] as ReadonlyArray<string> },
  { href: routes.catalog, label: ui.nav.catalog, areas: CATALOG_AREAS },
  { href: routes.calendar, label: ui.calendar.navLabel, areas: CALENDAR_AREAS },
  { href: routes.search, label: ui.search.navLabel, areas: [] as ReadonlyArray<string> },
];

const within = (path: string, prefix: string) => path === prefix || path.startsWith(`${prefix}/`);

/** `page` for the current page, `true` for the area that contains it, otherwise nothing. */
const currentOf = (link: (typeof links)[number]): 'page' | 'true' | undefined => {
  if (link.href === currentPath) return 'page';
  if (link.href !== routes.home && within(currentPath, link.href)) return 'true';
  return link.areas.some((area) => within(currentPath, area)) ? 'true' : undefined;
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href={routes.home} aria-label={ui.homeLinkLabel}>
      {ui.siteName}
    </a>
    <nav aria-label={ui.nav.label}>
      <ul class="site-header__nav" role="list">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={currentOf(link)}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    color: var(--color-on-shell);
    background: var(--color-shell);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-4);
    padding-block: var(--space-1);
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: inherit;
    font-weight: 600;
    text-decoration-color: transparent;
    text-underline-offset: 0.35em;
  }

  .site-header__nav a:hover {
    text-decoration-color: currentColor;
  }

  .site-header__nav a[aria-current] {
    text-decoration-color: var(--color-focus-on-shell);
    text-decoration-thickness: 3px;
  }

  .site-header__nav a[aria-current='true'] {
    text-decoration-style: dotted;
  }

  .site-header a:focus-visible {
    outline-color: var(--color-focus-on-shell);
  }

  @media (max-width: 26rem) {
    .site-header__nav {
      gap: 0 var(--space-3);
    }
  }
</style>
