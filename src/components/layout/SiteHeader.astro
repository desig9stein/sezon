---
import { PRODUCE_KINDS } from '@contexts/catalog';
import { buildMonth } from '@composition/clock';
import { monthName, ui } from '@i18n/bg';
import { routes } from './routes';

/** Site banner with the logo link and the main navigation. */
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const links = [
  { href: routes.home, label: ui.nav.now },
  { href: routes.month(buildMonth.next()), label: ui.nav.next(monthName(buildMonth.next())) },
  ...PRODUCE_KINDS.map((kind) => ({ href: routes.section(kind), label: ui.sections.names[kind] })),
  { href: routes.calendar, label: ui.calendar.navLabel },
  { href: routes.search, label: ui.search.navLabel },
];

/** `page` for the current page, `true` for the section that contains it, otherwise nothing. */
const currentOf = (href: string): 'page' | 'true' | undefined => {
  if (href === currentPath) return 'page';
  return href !== routes.home && currentPath.startsWith(`${href}/`) ? 'true' : undefined;
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href={routes.home} aria-label={ui.homeLinkLabel}>
      {ui.siteName}
    </a>
    <nav aria-label={ui.nav.label}>
      <ul class="site-header__nav" role="list">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={currentOf(link.href)}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-background);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-6);
    padding-block: var(--space-3);
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    font-family: var(--font-family-display);
    font-size: var(--font-size-xl);
    font-style: italic;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: var(--color-text);
    font-weight: 500;
  }

  .site-header__nav a[aria-current] {
    color: var(--color-accent);
    text-decoration-thickness: 3px;
  }

  .site-header__nav a[aria-current='true'] {
    text-decoration-style: dotted;
  }

  @media (max-width: 60rem) {
    .site-header__inner {
      padding-block: var(--space-2);
    }

    .site-header__nav {
      gap: 0 var(--space-3);
      font-size: var(--font-size-sm);
    }

    .site-header__nav a {
      min-height: 2.25rem;
    }
  }
</style>
