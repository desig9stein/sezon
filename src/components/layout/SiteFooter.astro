---
import { Month } from '@contexts/seasonality';
import { buildMonth, buildYear } from '@composition/clock';
import { CONTACT_EMAIL, correctionLinks } from '@composition/contact';
import { requireSiteUrl } from '@composition/site';
import { monthName, ui } from '@i18n/bg';
import { routes } from './routes';

/**
 * Site footer: a year strip of links to every month page with the build month marked, then links
 * to the calendar, the about and methodology pages, the RSS feed, adding a farm, and an error
 * report for the current page (the GitHub form and an email) at `path`, the health disclaimer and
 * the copyright.
 */
interface Props {
  /** Site-relative canonical path of the page the footer is on. */
  path: string;
}

const { path } = Astro.props;
const pageUrl = new URL(path, requireSiteUrl(Astro.site)).toString();
const report = correctionLinks(pageUrl, CONTACT_EMAIL);
const labels = ui.footer;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <nav aria-label={ui.footer.monthsLabel}>
      <ol class="site-footer__months" role="list">
        {Month.all().map((month) => (
          <li>
            <a href={routes.month(month)} aria-current={month === buildMonth ? 'date' : undefined}>
              {monthName(month)}
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <nav aria-label={labels.linksLabel}>
      <ul class="site-footer__links" role="list">
        <li>
          <a href={routes.calendar}>{ui.calendar.heading}</a>
        </li>
        <li>
          <a href={routes.about}>{labels.about}</a>
        </li>
        <li>
          <a href={routes.methodology}>{labels.methodology}</a>
        </li>
        <li>
          <a href={routes.feed}>{labels.feed}</a>
        </li>
        <li>
          <a href={routes.addFarm}>{labels.addFarm}</a>
        </li>
        <li>
          <a href={report.github}>{labels.report}</a>
        </li>
        <li>
          <a href={report.email}>{labels.reportEmail}</a>
        </li>
      </ul>
    </nav>
    <p class="site-footer__disclaimer">{ui.footer.disclaimer}</p>
    <p>{ui.footer.copyright(buildYear)}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-16);
    border-top: 1px solid var(--color-rule);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-8);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    padding: 0;
    list-style: none;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }

  .site-footer__months {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
    padding: 0;
    list-style: none;
  }

  .site-footer__months a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--target-min);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    background: var(--color-background);
    text-align: center;
    text-decoration: none;
  }

  .site-footer__months a:focus-visible {
    position: relative;
    z-index: 1;
  }

  .site-footer__months a:hover {
    text-decoration: underline;
  }

  .site-footer__months a[aria-current='date'] {
    border-color: var(--color-text);
    color: var(--color-on-marker);
    background: var(--color-marker);
    font-weight: 700;
  }

  .site-footer__disclaimer {
    max-width: var(--reading-width);
  }

  @media (min-width: 23rem) {
    .site-footer__months {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 36rem) {
    .site-footer__months {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .site-footer__months {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
  }
</style>
