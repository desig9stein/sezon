---
import { ui } from '@i18n/bg';

/**
 * Focusable, horizontally scrollable region for a data table, with the shared table styles:
 * start-aligned headers, end-aligned numbers, hairline rows and row-header links at least 24 px
 * tall. The region is named after the table caption with a short scrolling suffix, so it is told
 * apart from other tables on the page without repeating the caption as is. A small script removes
 * the Tab stop and the name while the table fits its box and restores them when it overflows
 * (spec 062); without JavaScript the region stays focusable.
 */
interface Props {
  /** Caption text of the table inside. */
  caption: string;
}

const { caption } = Astro.props;
---

<section
  class="table-scroll"
  aria-label={ui.scrollTable.label(caption)}
  tabindex="0"
  data-scroll-table
>
  <slot />
</section>

<script>
  import { watchScrollTables } from './scrollTable';

  watchScrollTables(document.querySelectorAll<HTMLElement>('[data-scroll-table]'));
</script>

<style>
  .table-scroll {
    position: relative;
    overflow-x: auto;
  }

  .table-scroll :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .table-scroll :global(caption) {
    text-align: start;
    font-weight: 700;
    padding-bottom: var(--space-2);
  }

  .table-scroll :global(th),
  .table-scroll :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    text-align: start;
  }

  .table-scroll :global(td) {
    text-align: end;
  }

  .table-scroll :global(th a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-compact);
  }

  @media print {
    .table-scroll :global(th a) {
      display: inline;
      min-height: 0;
    }
  }

  .table-scroll :global(abbr) {
    text-decoration: none;
  }
</style>
