---
/**
 * Focusable, horizontally scrollable region for a data table, labelled by the table caption, with
 * the shared table styles: start-aligned headers, end-aligned numbers and hairline rows.
 */
interface Props {
  captionId: string;
}

const { captionId } = Astro.props;
---

<section class="table-scroll" aria-labelledby={captionId} tabindex="0">
  <slot />
</section>

<style>
  .table-scroll {
    position: relative;
    overflow-x: auto;
  }

  .table-scroll :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .table-scroll :global(caption) {
    text-align: start;
    font-weight: 700;
    padding-bottom: var(--space-2);
  }

  .table-scroll :global(th),
  .table-scroll :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    text-align: start;
  }

  .table-scroll :global(td) {
    text-align: end;
  }

  .table-scroll :global(abbr) {
    text-decoration: none;
  }
</style>
