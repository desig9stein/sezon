---
import { ui } from '@i18n/bg';

/**
 * Focusable, horizontally scrollable region for a data table, with the shared table styles:
 * start-aligned headers, end-aligned numbers, hairline rows and row-header links at least 24 px
 * tall. The region has a short name of its own, so the table caption is announced once.
 */
---

<section class="table-scroll" aria-label={ui.scrollTable.label} tabindex="0">
  <slot />
</section>

<style>
  .table-scroll {
    position: relative;
    overflow-x: auto;
  }

  .table-scroll :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .table-scroll :global(caption) {
    text-align: start;
    font-weight: 700;
    padding-bottom: var(--space-2);
  }

  .table-scroll :global(th),
  .table-scroll :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    text-align: start;
  }

  .table-scroll :global(td) {
    text-align: end;
  }

  .table-scroll :global(th a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-compact);
  }

  @media print {
    .table-scroll :global(th a) {
      display: inline;
      min-height: 0;
    }
  }

  .table-scroll :global(abbr) {
    text-decoration: none;
  }
</style>
