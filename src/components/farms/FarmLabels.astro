---
import type { Farm } from '@contexts/farms';
import { ui } from '@i18n/bg';

/**
 * A farm's outlined labels, as inline items: organic with the certifier and the certificate
 * number, linked to the certificate (spec 061), when `certifiedOrganic`, and sponsored. Renders
 * nothing when neither applies.
 */
interface Props {
  farm: Farm;
  certifiedOrganic: boolean;
}

const { farm, certifiedOrganic } = Astro.props;
const labels = ui.produce.farms;
---

{certifiedOrganic && farm.organic !== undefined && (
  <a class="farm-label" href={farm.organic.url} rel="noopener">
    {labels.organic(farm.organic.certifier, farm.organic.certificateId)}
  </a>
)}
{farm.sponsored && <span class="farm-label">{labels.sponsored}</span>}

<style>
  .farm-label {
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
</style>
