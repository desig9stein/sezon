---
import type { Farm } from '@contexts/farms';
import { ui } from '@i18n/bg';
import { directoryName } from './directoryName';

/**
 * A farm's contact links as a list: website, email and phone, whichever the farm has. Each link's
 * accessible name includes the farm name; a website that is a LocalStore.bg or Хранкооп profile is
 * named as a profile in that directory; the phone number does not wrap. A sponsored farm's
 * website link is marked `rel="sponsored noopener"`.
 */
interface Props {
  farm: Farm;
}

const { farm } = Astro.props;
const labels = ui.produce.farms;
/** A sponsored farm's website is a paid link (Google's guidance on qualifying outbound links). */
const websiteRel = farm.sponsored ? 'sponsored noopener' : 'noopener';
const website = farm.contact.website;
const directory = website === undefined ? undefined : directoryName(website);
const websiteLabel =
  directory === undefined
    ? labels.website(farm.name)
    : labels.directoryProfile(farm.name, directory);
---

<ul class="farm-contacts" role="list">
  {website !== undefined && (
    <li>
      <a href={website} rel={websiteRel}>
        {websiteLabel}
      </a>
    </li>
  )}
  {farm.contact.email !== undefined && (
    <li>
      <a href={`mailto:${farm.contact.email}`}>{labels.email(farm.name)}</a>
    </li>
  )}
  {farm.contact.phone !== undefined && (
    <li>
      <span aria-hidden="true">{labels.phoneLabel}</span>{' '}
      <a
        class="farm-contacts__phone"
        href={`tel:${farm.contact.phone}`}
        aria-label={labels.phone(farm.name, farm.contact.phone)}
      >
        {farm.contact.phone}
      </a>
    </li>
  )}
</ul>

<style>
  .farm-contacts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .farm-contacts a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }

  .farm-contacts__phone {
    white-space: nowrap;
  }
</style>
