---
import { FEED_MEDIA_TYPE } from '@components/layout/routes';
import { palettes } from '@design/tokens';
import type { PageMeta } from '@shared/seo';

/**
 * Renders title, description, canonical, robots, Open Graph, Twitter, theme-color, favicon and RSS
 * autodiscovery tags. With `noindex`, the page is excluded from indexing and has no canonical or
 * `og:url`.
 */
interface Props {
  meta: PageMeta;
  /** Title and absolute URL of the site's RSS feed. */
  feed: { readonly title: string; readonly url: string };
  noindex?: boolean;
}

const { meta, feed, noindex = false } = Astro.props;
---

<title>{meta.title}</title>
<meta name="description" content={meta.description} />
{!noindex && <link rel="canonical" href={meta.canonicalUrl} />}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
{!noindex && <meta property="og:url" content={meta.canonicalUrl} />}
<meta property="og:type" content={meta.ogType} />
<meta property="og:locale" content={meta.locale} />
<meta property="og:site_name" content={meta.siteName} />
<meta name="twitter:card" content="summary" />
<meta
  name="theme-color"
  content={palettes.light.background}
  media="(prefers-color-scheme: light)"
/>
<meta name="theme-color" content={palettes.dark.background} media="(prefers-color-scheme: dark)" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type={FEED_MEDIA_TYPE} title={feed.title} href={feed.url} />
