---
import '../styles/base.css';
import { Font } from 'astro:assets';
import Breadcrumbs from '@components/layout/Breadcrumbs.astro';
import { routes } from '@components/layout/routes';
import SiteFooter from '@components/layout/SiteFooter.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';
import SkipLink from '@components/layout/SkipLink.astro';
import JsonLd from '@components/seo/JsonLd.astro';
import Seo from '@components/seo/Seo.astro';
import { ogImageMeta, siteOgCard, type OgImageRef } from '@components/seo/ogImage';
import { requireSiteUrl } from '@composition/site';
import { tokensToCss } from '@design/tokens';
import { ui } from '@i18n/bg';
import {
  absoluteUrl,
  buildPageMeta,
  type BreadcrumbItem,
  type JsonLd as JsonLdData,
  type OgType,
} from '@shared/seo';

/** Page shell: document head with SEO tags, skip link, header, breadcrumbs, main and footer. */
interface Props {
  title: string;
  description: string;
  path: string;
  type?: OgType;
  breadcrumbs?: ReadonlyArray<BreadcrumbItem>;
  jsonLd?: ReadonlyArray<JsonLdData>;
  noindex?: boolean;
  /** Share image of the page; defaults to the site card (spec 050). */
  ogImage?: OgImageRef;
}

const {
  title,
  description,
  path,
  type,
  breadcrumbs,
  jsonLd = [],
  noindex = false,
  ogImage = siteOgCard(),
} = Astro.props;
const siteUrl = requireSiteUrl(Astro.site);
const meta = buildPageMeta({
  title,
  description,
  path,
  siteUrl,
  siteName: ui.siteName,
  type,
});
const image = ogImageMeta(siteUrl, ogImage);
const feed = { title: ui.feed.title, url: absoluteUrl(siteUrl, routes.feed) };
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo meta={meta} image={image} feed={feed} noindex={noindex} />
    <Font cssVariable="--font-sofia-sans-extra-condensed" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-sofia-sans" preload={[{ style: 'normal' }]} />
    <style is:inline set:html={tokensToCss()}></style>
    {jsonLd.length > 0 && <JsonLd data={jsonLd} />}
  </head>
  <body>
    <SkipLink />
    <SiteHeader currentPath={path} />
    {breadcrumbs !== undefined && breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
    <main id="main" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>
    <SiteFooter path={path} />
  </body>
</html>
