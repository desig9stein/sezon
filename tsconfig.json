{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "coverage",
    ".lighthouseci",
    "playwright-report",
    "test-results"
  ],
  "compilerOptions": {
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@contexts/*": ["./src/contexts/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@tests/*": ["./tests/*"]
    }
  }
}
